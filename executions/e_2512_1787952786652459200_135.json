      "import math\nfrom fractions import Fraction as F\nfrom functools import reduce\ndef rising(v,n): return math.prod(v+i for i in range(n))\ndef cvec(g,a): return [math.comb(g,j)*(-1)**(g-j)*rising(a,g-j)*rising(4-a,j) for j in range(g+1)]\ndef pvec(g,a,m):\n c=cvec(g,a); return [m*c[0]]+[(m+j)*c[j]+(m+j-1-g)*c[j-1] for j in range(1,g+1)]+[m*c[g]]\ndef col(g,a,m):\n d=1-g-(a+m); s=-a-g if d>0 else -a-g+abs(d); sg=1 if d>0 else -1\n return {s+j:sg*x for j,x in enumerate(pvec(g,a,m)) if x}\ndef comp(g,k,q):\n cen=1-g; return [col(g,a,m) for a in range(0,2*k+1,2) for m in (cen-q-a,cen+q-a)]\ndef defect(g,a,q):\n c=cvec(g,a); J=[c[0]]+[c[j]+c[j-1] for j in range(1,g+1)]+[c[g]]; out={}\n for s,sg in [(-a-g,-2),(-a-g+q+2,2)]:\n  for j,x in enumerate(J): out[s+j]=out.get(s+j,0)+sg*x\n return {r:x for r,x in out.items() if x}\ndef solve(M,y):\n A=[[F(x) for x in row]+[F(v)] for row,v in zip(M,y)]; m=len(A); n=len(A[0])-1; piv=[]; r=0\n for c in range(n):\n  p=next((i for i in range(r,m) if A[i][c]),None)\n  if p is None: continue\n  A[r],A[p]=A[p],A[r]; z=A[r][c]; A[r]=[x/z for x in A[r]]\n  for i in range(m):\n   if i!=r and A[i][c]:\n    z=A[i][c]; A[i]=[A[i][j]-z*A[r][j] for j in range(n+1)]\n  piv.append(c); r+=1\n for i in range(r,m):\n  if all(A[i][j]==0 for j in range(n)) and A[i][n]: return None\n x=[F(0) for _ in range(n)]\n for i,c in enumerate(piv): x[c]=A[i][n]\n return x\ndef cert(g,k,q,a=0):\n cols=comp(g,k,q+2); b=defect(g,a,q); rows=sorted(set(b)|{r for c in cols for r in c})\n lam=solve([[c.get(r,0) for r in rows] for c in cols]+[[b.get(r,0) for r in rows]],[0]*len(cols)+[1])\n den=math.lcm(*[x.denominator for x in lam]); z=[int(x*den) for x in lam]; gg=reduce(math.gcd,[abs(x) for x in z if x]or[1]); z=[x//gg for x in z]\n return tuple((r,x) for r,x in zip(rows,z) if x)\nfor g in range(2,9):\n for q in range(1,6):\n  z=cert(g,8,q); stable=all(cert(g,k,q)==z for k in range(2,9))\n  print((g,q),'stable',stable,'support',len(z),'cert',z[:8],('...' if len(z)>8 else ''))"
