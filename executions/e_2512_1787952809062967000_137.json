      "-c",
      "import math\nfrom fractions import Fraction as F\ndef rising(v,n): return math.prod(v+i for i in range(n))\ndef cv(g,a): return [math.comb(g,j)*(-1)**(g-j)*rising(a,g-j)*rising(4-a,j) for j in range(g+1)]\ndef pv(g,a,m):\n c=cv(g,a); return [m*c[0]]+[(m+j)*c[j]+(m+j-1-g)*c[j-1] for j in range(1,g+1)]+[m*c[g]]\ndef col(g,a,m):\n d=1-g-a-m;s=-a-g if d>0 else -a-g+abs(d);sg=1 if d>0 else -1\n return {s+j:sg*x for j,x in enumerate(pv(g,a,m)) if x}\ndef comp(g,k,q):\n c=1-g;return [col(g,a,m) for a in range(0,2*k+1,2) for m in(c-q-a,c+q-a)]\ndef defect(g,a,q):\n c=cv(g,a);J=[c[0]]+[c[j]+c[j-1] for j in range(1,g+1)]+[c[g]];o={}\n for s,z in((-a-g,-2),(-a-g+q+2,2)):\n  for j,x in enumerate(J):o[s+j]=o.get(s+j,0)+z*x\n return {r:x for r,x in o.items() if x}\ndef rank(M):\n A=[[F(x) for x in z] for z in M];m=len(A);n=len(A[0])if m else 0;r=0\n for c in range(n):\n  p=next((i for i in range(r,m)if A[i][c]),None)\n  if p is None:continue\n  A[r],A[p]=A[p],A[r];z=A[r][c];A[r]=[x/z for x in A[r]]\n  for i in range(r+1,m):\n   if A[i][c]:\n    z=A[i][c];A[i]=[A[i][j]-z*A[r][j] for j in range(n)]\n  r+=1\n return r\ndef shortest(g,k,q,a=0):\n C=comp(g,k,q+2);b=defect(g,a,q);rows=sorted(set(b)|{r for c in C for r in c})\n for L in range(1,len(rows)+1):\n  for s in range(len(rows)-L+1):\n   I=rows[s:s+L];B=[[c.get(r,0)for r in I]for c in C];bi=[b.get(r,0)for r in I]\n   if rank(B)<rank(B+[bi]):return (L,I[0],I[-1])\nfor g in range(2,7):\n for q in range(1,6):\n  z=[shortest(g,k,q)for k in range(2,9)]\n  print((g,q),z,'stable',len(set(z))==1)"
