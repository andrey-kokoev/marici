{-# OPTIONS --safe --cubical --guardedness #-}
module CoherentDependentExtensions where

open import Cubical.Foundations.Prelude
open import Cubical.Foundations.Equiv
open import Cubical.Foundations.Isomorphism
open import Cubical.Foundations.HLevels using (isContrRetract)
open import Cubical.Data.Sigma.Properties using (Σ-cong-equiv)
open import Cubical.Relation.Nullary.Base using (¬_)

record Family (ℓ : Level) : Type (ℓ-suc ℓ) where
  field
    Base : Type ℓ
    Witness : Base → Type ℓ
open Family public

Total : {ℓ : Level} → Family ℓ → Type ℓ
Total F = Σ (Base F) (Witness F)

record Map {ℓ : Level} (F G : Family ℓ) : Type ℓ where
  field
    base : Base F → Base G
    witness : (x : Base F) → Witness F x → Witness G (base x)
open Map

totalMap : {ℓ : Level} {F G : Family ℓ} → Map F G → Total F → Total G
totalMap f (x , w) = base f x , witness f x w
identity : {ℓ : Level} (F : Family ℓ) → Map F F
base (identity F) x = x
witness (identity F) x w = w
compose : {ℓ : Level} {F G H : Family ℓ} → Map F G → Map G H → Map F H
base (compose f g) x = base g (base f x)
witness (compose f g) x w = witness g (base f x) (witness f x w)
identity-law : {ℓ : Level} (F : Family ℓ) → totalMap (identity F) ≡ (λ x → x)
identity-law F = refl
composition-law : {ℓ : Level} {F G H : Family ℓ} (f : Map F G) (g : Map G H)
  → totalMap (compose f g) ≡ (λ x → totalMap g (totalMap f x))
composition-law f g = refl
associative-law : {ℓ : Level} {F G H K : Family ℓ}
  (f : Map F G) (g : Map G H) (h : Map H K)
  → totalMap (compose (compose f g) h) ≡ totalMap (compose f (compose g h))
associative-law f g h = refl

record Comparison {ℓ : Level} (F G : Family ℓ) : Type ℓ where
  field
    baseEquiv : Base F ≃ Base G
    witnessEquiv : (x : Base F) → Witness F x ≃ Witness G (equivFun baseEquiv x)
open Comparison public

underlying : {ℓ : Level} {F G : Family ℓ} → Comparison F G → Map F G
base (underlying e) = equivFun (baseEquiv e)
witness (underlying e) x = equivFun (witnessEquiv e x)
liftComparison : {ℓ : Level} {F G : Family ℓ} → Comparison F G → Total F ≃ Total G
liftComparison e = Σ-cong-equiv (baseEquiv e) (witnessEquiv e)
lift-computes : {ℓ : Level} {F G : Family ℓ} (e : Comparison F G)
  → equivFun (liftComparison e) ≡ totalMap (underlying e)
lift-computes e = refl

identityComparison : {ℓ : Level} (F : Family ℓ) → Comparison F F
baseEquiv (identityComparison F) = idEquiv _
witnessEquiv (identityComparison F) x = idEquiv _
composeComparison : {ℓ : Level} {F G H : Family ℓ}
  → Comparison F G → Comparison G H → Comparison F H
baseEquiv (composeComparison e f) = compEquiv (baseEquiv e) (baseEquiv f)
witnessEquiv (composeComparison e f) x =
  compEquiv (witnessEquiv e x) (witnessEquiv f (equivFun (baseEquiv e) x))
lift-identity : {ℓ : Level} (F : Family ℓ) → liftComparison (identityComparison F) ≡ idEquiv _
lift-identity F = equivEq refl
lift-composition : {ℓ : Level} {F G H : Family ℓ} (e : Comparison F G) (f : Comparison G H)
  → liftComparison (composeComparison e f) ≡ compEquiv (liftComparison e) (liftComparison f)
lift-composition e f = equivEq refl
lift-associativity : {ℓ : Level} {F G H K : Family ℓ}
  (e : Comparison F G) (f : Comparison G H) (g : Comparison H K)
  → liftComparison (composeComparison (composeComparison e f) g)
    ≡ liftComparison (composeComparison e (composeComparison f g))
lift-associativity e f g = equivEq refl

-- Actual supplied comparisons of comparisons survive; no missing filler is
-- generated by these maps, and no proof irrelevance of witness types is used.
lift-path : {ℓ : Level} {F G : Family ℓ} {e f : Comparison F G}
  → e ≡ f → liftComparison e ≡ liftComparison f
lift-path = cong liftComparison
lift-higher : {ℓ : Level} {F G : Family ℓ} {e f : Comparison F G}
  {p q : e ≡ f} → p ≡ q → lift-path p ≡ lift-path q
lift-higher = cong lift-path

module Composition {ℓ : Level} (X : Type ℓ) (W : X → Type ℓ)
  (V : (x : X) → W x → Type ℓ) where
  Nested Combined : Type ℓ
  Nested = Σ (Σ X W) (λ z → V (fst z) (snd z))
  Combined = Σ X (λ x → Σ (W x) (V x))
  reassociate : Iso Nested Combined
  Iso.fun reassociate ((x , w) , v) = x , w , v
  Iso.inv reassociate (x , w , v) = (x , w) , v
  Iso.rightInv reassociate _ = refl
  Iso.leftInv reassociate _ = refl
  -- Recovery of each retained field is exact, not mere existential descent.
  source-recovered : (z : Nested) → fst (Iso.fun reassociate z) ≡ fst (fst z)
  source-recovered z = refl

module ReassociationNaturality {ℓ : Level}
  (X Y : Type ℓ) (W : X → Type ℓ) (W' : Y → Type ℓ)
  (V : (x : X) → W x → Type ℓ) (V' : (y : Y) → W' y → Type ℓ)
  (f : X → Y) (g : (x : X) → W x → W' (f x))
  (h : (x : X) (w : W x) → V x w → V' (f x) (g x w)) where
  module L = Composition X W V
  module R = Composition Y W' V'
  nestedMap : L.Nested → R.Nested
  nestedMap ((x , w) , v) = (f x , g x w) , h x w v
  combinedMap : L.Combined → R.Combined
  combinedMap (x , w , v) = f x , g x w , h x w v
  square : (z : L.Nested)
    → Iso.fun R.reassociate (nestedMap z) ≡ combinedMap (Iso.fun L.reassociate z)
  square z = refl

module Projection {ℓ : Level} (X : Type ℓ) (W : X → Type ℓ) where
  -- Contractible witness fibers make THIS projection an equivalence.
  contractible-projection : ((x : X) → isContr (W x)) → Iso (Σ X W) X
  Iso.fun (contractible-projection c) = fst
  Iso.inv (contractible-projection c) x = x , fst (c x)
  Iso.rightInv (contractible-projection c) x = refl
  Iso.leftInv (contractible-projection c) (x , w) i = x , snd (c x) w i
  projection-isEquiv-forces-contractible : isEquiv (λ (z : Σ X W) → fst z)
    → (x : X) → isContr (W x)
  projection-isEquiv-forces-contractible e x = isContrRetract
    (λ w → (x , w) , refl)
    (λ { ((y , w) , p) → subst W p w })
    (λ w → substRefl {B = W} {x = x} w)
    (equiv-proof e x)
  noncontractible-projection : (x : X) → ¬ (isContr (W x))
    → ¬ (isEquiv (λ (z : Σ X W) → fst z))
  noncontractible-projection x noncontractible e =
    noncontractible (projection-isEquiv-forces-contractible e x)
  -- A missing witness excludes every total extension lying over that boundary.
  blocked : (x : X) → ¬ (W x) → ¬ (Σ (Σ X W) (λ z → fst z ≡ x))
  blocked x absent ((y , w) , p) = absent (subst W p w)
