{
  "schema": "marici.dpc-core-normalizer.v1",
  "rewrite_rules": ["typed_identity", "transport_fusion", "scope_attenuation", "support_union", "partition_flattening", "coherence_inverse", "epoch_fence"],
  "legacy_projection_audit": {
    "source": "contracts/authority-grant-composition.v1.json",
    "permit_defaulting": false,
    "required_core_fields": ["nominal_identity", "scope", "modality", "resource", "physical_support_roots", "epoch"]
  },
  "native_capabilities": [
    {
      "id": "native_manifest_challenge_use",
      "nominal_identity": "cap:manifest-challenge:e:use1",
      "authority_kind": "executor",
      "scope": ["submit_manifest_challenge"],
      "modality": "linear",
      "resource": {"challenge_uses": 1},
      "physical_support_roots": ["challenge_ledger", "configuration_quorum"],
      "epoch": {"parameter": "e", "offset": 0},
      "executable_output": "challenge_receipt",
      "operations": [{"kind":"epoch_fence","minimum_epoch":{"parameter":"e","offset":0}}],
      "source_constructor_evidence": "one source-issued challenge use bound to arbitrary active epoch e and the configuration quorum"
    }
  ],
  "epoch_successor_events": [
    {
      "id": "advance_e_0_to_e_1",
      "predecessor_epoch": {"parameter":"e","offset":0},
      "successor_epoch": {"parameter":"e","offset":1},
      "predecessor_state_sha256": "4db11f7fdf32d39c86bd008eff81059c03693b2fe88ec41dcbac6bf200f79115",
      "successor_state_sha256": "9f97df16c51d471e002f5ff7b43b24c35eeba81e7115693775f44217b8ff3478",
      "configuration_authority_roots": ["config_root_A","config_root_B"],
      "joint_configuration_certificate": "joint-config-transition-e0-e1",
      "certificate_nonce": "nonce:advance:e0:e1:1",
      "certificate_quorum": ["config_root_A","config_root_B"],
      "authorized_signers": {
        "config_root_A": {"durable_non_equivocation":true,"independence_root":"admin_A"},
        "config_root_B": {"durable_non_equivocation":true,"independence_root":"admin_B"}
      },
      "admissible_signer_fault_sets": [["config_root_A"],["config_root_B"]],
      "durable_non_equivocation": true,
      "competing_successor_constructible": false,
      "physical_state_correspondence": {
        "executor_id":"manifest_executor_1",
        "measured_state_sha256":"9f97df16c51d471e002f5ff7b43b24c35eeba81e7115693775f44217b8ff3478",
        "verifier_authority_root":"executor_attestation_root",
        "verifier_independence_root":"admin_C",
        "certificate_nonce":"nonce:advance:e0:e1:1",
        "attested_epoch":{"parameter":"e","offset":1},
        "monotone_boot_counter":41,
        "accepted_counter_floor":41,
        "signature_verified":true,
        "measurement_constructor":"measured boot binds executor state to successor digest",
        "verified_before_epoch_acceptance":true
      }
    }
  ],
  "active_rewrite_footprints": {
    "partition_flattening": ["resource"],
    "scope_attenuation": ["scope"],
    "support_union": ["support"],
    "transport_fusion": ["transport_chain"],
    "coherence_inverse": ["coherence_chain"],
    "typed_identity": ["authority_kind", "scope", "modality", "support", "resource"],
    "epoch_fence": ["epoch", "status", "executable_output"]
  },
  "critical_pair_coverage": {
    "partition_flattening|typed_identity": "identity_then_partition_joins",
    "scope_attenuation|typed_identity": "identity_then_attenuate_joins"
    ,"support_union|typed_identity": "identity_then_support_union_joins"
  },
  "normalization_cases": [
    {
      "id": "symbolic_successor_epoch_fences_predecessor",
      "expected": {"status":"rejected_stale_epoch","executable_output":"REJECT:stale_epoch"},
      "input": {"authority_kind":"executor","scope":["act"],"modality":"linear","support":["ledger"],"resource":{"uses":1},"epoch":{"parameter":"e","offset":0},"status":"active","executable_output":"effect","operations":[{"kind":"epoch_fence","minimum_epoch":{"parameter":"e","offset":1}}]}
    },
    {
      "id": "unrelated_epoch_families_are_incomparable",
      "expected": {},
      "expected_error": "incomparable_epoch_parameters",
      "input": {"authority_kind":"executor","scope":["act"],"modality":"linear","support":["ledger"],"resource":{"uses":1},"epoch":{"parameter":"e","offset":0},"status":"active","executable_output":"effect","operations":[{"kind":"epoch_fence","minimum_epoch":{"parameter":"f","offset":0}}]}
    },
    {
      "id": "full_signature_coherence_roundtrip_eliminates",
      "expected": {"operations": []},
      "input": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["source_A"],"resource":{"queries":1},"executable_output":"value","operations":[{"kind":"coherence","cell":"phi","inverse_of":"phi_inv","invertible":true,"preserves_full_signature":true},{"kind":"coherence","cell":"phi_inv","inverse_of":"phi","invertible":true,"preserves_full_signature":true}]}
    },
    {
      "id": "signature_changing_roundtrip_rejected",
      "expected": {},
      "expected_error": "coherence_inverse_changes_authority_signature",
      "input": {"authority_kind":"executor","scope":["act"],"modality":"linear","support":["source_A"],"resource":{"uses":1},"executable_output":"effect","operations":[{"kind":"coherence","cell":"phi","inverse_of":"phi_inv","invertible":true,"preserves_full_signature":true},{"kind":"coherence","cell":"phi_inv","inverse_of":"phi","invertible":true,"preserves_full_signature":false}]}
    },
    {
      "id": "noninvertible_presentation_cell_rejected",
      "expected": {},
      "expected_error": "coherence_inverse_not_invertible",
      "input": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["source_A"],"resource":{"queries":1},"executable_output":"value","operations":[{"kind":"coherence","cell":"phi","inverse_of":"phi_inv","invertible":false,"preserves_full_signature":true},{"kind":"coherence","cell":"phi_inv","inverse_of":"phi","invertible":true,"preserves_full_signature":true}]}
    },
    {
      "id": "authority_preserving_transport_chain_fuses",
      "expected": {"operations":[{"kind":"transport","source":"chart_A","target":"chart_C","preserves_authority":true,"normal_form_cell":"cell_AC"}]},
      "input": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["source_chart"],"resource":{"queries":1},"executable_output":"value","operations":[{"kind":"transport","source":"chart_A","target":"chart_B","preserves_authority":true},{"kind":"transport","source":"chart_B","target":"chart_C","preserves_authority":true,"fusion_cell":"cell_AC"}]}
    },
    {
      "id": "evidence_transport_without_authority_is_rejected",
      "expected": {},
      "expected_error": "transport_fusion_loses_authority",
      "input": {"authority_kind":"executor","scope":["act"],"modality":"linear","support":["source_A"],"resource":{"uses":1},"executable_output":"effect","operations":[{"kind":"transport","source":"logical","target":"encoded","preserves_authority":true},{"kind":"transport","source":"encoded","target":"physical","preserves_authority":false,"fusion_cell":"unsupported_cell"}]}
    },
    {
      "id": "support_union_preserves_distinct_roots_and_removes_duplicates",
      "expected": {"support": ["root_A", "root_B"]},
      "input": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["root_A"],"resource":{"queries":1},"executable_output":"bit","operations":[{"kind":"support_union","support":["root_B","root_A","root_B"]}]}
    },
    {
      "id": "conservative_partition",
      "expected": {"resource": {"site_A": 2, "site_B": 3}, "status": "active"},
      "input": {"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"global":5},"status":"active","executable_output":"partitioned","operations":[{"kind":"partition","source":"global","children":{"site_A":2,"site_B":3}}]}
    },
    {
      "id": "inflating_partition_rejected",
      "expected": {},
      "expected_error": "resource_partition_inflation",
      "input": {"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"global":5},"status":"active","executable_output":"partitioned","operations":[{"kind":"partition","source":"global","children":{"site_A":3,"site_B":3}}]}
    },
    {
      "id": "stale_epoch_becomes_auditable_rejection",
      "expected": {"status":"rejected_stale_epoch","executable_output":"REJECT:stale_epoch"},
      "input": {"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"credits":1},"epoch":7,"status":"active","executable_output":"receipt","operations":[{"kind":"epoch_fence","minimum_epoch":8}]}
    }
  ],
  "critical_pairs": [
    {
      "id": "identity_then_support_union_joins",
      "coherence_cell": "typed_identity_support_naturality",
      "expected_joined": true,
      "left": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["root_A"],"resource":{"queries":1},"executable_output":"bit","operations":[{"kind":"identity","signature":{"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["root_A"],"resource":{"queries":1}}},{"kind":"support_union","support":["root_B","root_A"]}]},
      "right": {"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["root_A"],"resource":{"queries":1},"executable_output":"bit","operations":[{"kind":"support_union","support":["root_B","root_A"]},{"kind":"identity","signature":{"authority_kind":"readout","scope":["observe"],"modality":"unrestricted","support":["root_A","root_B"],"resource":{"queries":1}}}]}
    },
    {
      "id": "identity_then_partition_joins",
      "coherence_cell": "typed_identity_resource_naturality",
      "expected_joined": true,
      "left": {"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"global":5},"executable_output":"partitioned","operations":[{"kind":"identity","signature":{"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"global":5}}},{"kind":"partition","source":"global","children":{"site_A":2,"site_B":3}}]},
      "right": {"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"global":5},"executable_output":"partitioned","operations":[{"kind":"partition","source":"global","children":{"site_A":2,"site_B":3}},{"kind":"identity","signature":{"authority_kind":"executor","scope":["spend"],"modality":"linear","support":["ledger"],"resource":{"site_A":2,"site_B":3}}}]}
    },
