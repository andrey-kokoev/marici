{
  "schema": "marici.dpc-core-normalizer.v1",
  "rewrite_rules": ["typed_identity", "transport_fusion", "scope_attenuation", "support_union", "partition_flattening", "coherence_inverse", "epoch_fence"],
  "legacy_projection_audit": {
    "source": "contracts/authority-grant-composition.v1.json",
    "permit_defaulting": false,
    "required_core_fields": ["nominal_identity", "scope", "modality", "resource", "physical_support_roots", "epoch"]
  },
  "native_capabilities": [
    {
      "id": "native_manifest_challenge_use",
      "nominal_identity": "cap:manifest-challenge:e:use1",
      "authority_kind": "executor",
      "scope": ["submit_manifest_challenge"],
      "modality": "linear",
      "resource": {"challenge_uses": 1},
      "physical_support_roots": ["challenge_ledger", "configuration_quorum"],
      "epoch": {"parameter": "e", "offset": 0},
      "bound_state_sha256":"4db11f7fdf32d39c86bd008eff81059c03693b2fe88ec41dcbac6bf200f79115",
      "executable_output": "challenge_receipt",
      "operations": [{"kind":"epoch_fence","minimum_epoch":{"parameter":"e","offset":0}}],
      "source_constructor_evidence": "one source-issued challenge use bound to arbitrary active epoch e and the configuration quorum"
    }
  ],
  "epoch_successor_events": [
    {
      "id": "advance_e_0_to_e_1",
      "predecessor_epoch": {"parameter":"e","offset":0},
      "successor_epoch": {"parameter":"e","offset":1},
      "predecessor_state_sha256": "4db11f7fdf32d39c86bd008eff81059c03693b2fe88ec41dcbac6bf200f79115",
      "successor_state_sha256": "9f97df16c51d471e002f5ff7b43b24c35eeba81e7115693775f44217b8ff3478",
      "configuration_authority_roots": ["config_root_A","config_root_B"],
      "joint_configuration_certificate": "joint-config-transition-e0-e1",
      "certificate_nonce": "nonce:advance:e0:e1:1",
      "certificate_quorum": ["config_root_A","config_root_B"],
      "authorized_signers": {
        "config_root_A": {"durable_non_equivocation":true,"independence_root":"admin_A"},
        "config_root_B": {"durable_non_equivocation":true,"independence_root":"admin_B"}
      },
      "admissible_signer_fault_sets": [["config_root_A"],["config_root_B"]],
      "durable_non_equivocation": true,
      "competing_successor_constructible": false,
      "physical_state_correspondence": {
        "executor_id":"manifest_executor_1",
        "measured_state_sha256":"9f97df16c51d471e002f5ff7b43b24c35eeba81e7115693775f44217b8ff3478",
        "verifier_authority_root":"executor_attestation_root",
        "verifier_independence_root":"admin_C",
        "certificate_nonce":"nonce:advance:e0:e1:1",
        "attested_epoch":{"parameter":"e","offset":1},
        "monotone_boot_counter":41,
        "accepted_counter_floor":41,
        "signature_verified":true,
        "measurement_constructor":"measured boot binds executor state to successor digest",
        "trusted_physical_base": {
          "hardware_root_id":"tpm:manifest-executor-1",
          "measured_ports":["boot_state","manifest_state","configuration_state"],
          "required_ports":["boot_state","manifest_state","configuration_state"],
          "anti_rollback_storage":true,
          "bounded_threat_model":"one non-cloned hardware root with intact measured boot and monotone counter storage",
          "claims_absolute_unclonability":false,
          "claims_universal_port_coverage":false,
          "challenge_interface":"admit newly discovered execution port or hardware common cause"
        },
        "verified_before_epoch_acceptance":true
      }
    }
  ],
  "native_execution_traces": [
    {
      "id":"execute_native_manifest_challenge_once",
      "capability_id":"native_manifest_challenge_use",
      "nominal_identity":"cap:manifest-challenge:e:use1",
      "epoch":{"parameter":"e","offset":0},
      "issuance":{"source_authorized":true,"issuer_root":"challenge_issuer","resource_amount":1},
      "consumption":{"nonce":"nonce:challenge:e:use1","atomic_compare_and_set":true,"prior_state":"unspent","post_state":"spent","nonce_durably_recorded":true},
      "execution":{"executor_id":"manifest_executor_1","attested_epoch":{"parameter":"e","offset":0},"attested_state_sha256":"4db11f7fdf32d39c86bd008eff81059c03693b2fe88ec41dcbac6bf200f79115","effect_sha256":"17c9586b6a74f347b93af4670efc0503869f8eb37a978f0a75379f481d8ad5d6","effect_committed_atomically_with_fence":true},
      "receipt":{"nonce":"nonce:challenge:e:use1","effect_sha256":"17c9586b6a74f347b93af4670efc0503869f8eb37a978f0a75379f481d8ad5d6","receiver":"manifest_challenge_ledger","receiver_signature_verified":true},
      "history":{"append_only":true,"entries":[{"kind":"issued"},{"kind":"consumed"},{"kind":"effect_committed"},{"kind":"receipt_recorded"}],"execution_fact_retained":true,"compensation_erases_history":false}
    }
  ],
  "trusted_base_cocircuit_audits": [
    {"id":"tcb_anti_rollback","target":"successor:advance_e_0_to_e_1","assumption":"anti_rollback_storage","primitive_failure_class":"rollback","singleton_deletion_error":"epoch_successor_attestation_tcb_unbounded"},
    {"id":"tcb_port_coverage","target":"successor:advance_e_0_to_e_1","assumption":"measured_ports_cover_required_ports","primitive_failure_class":"hidden_port","singleton_deletion_error":"epoch_successor_attestation_tcb_unbounded"},
    {"id":"tcb_hardware_nonclone_boundary","target":"successor:advance_e_0_to_e_1","assumption":"bounded_noncloned_hardware_root","primitive_failure_class":"clone","singleton_deletion_error":"epoch_successor_attestation_tcb_unbounded"},
    {"id":"tcb_signer_independence","target":"successor:advance_e_0_to_e_1","assumption":"independent_configuration_signer_roots","primitive_failure_class":"signer_fork","singleton_deletion_error":"epoch_successor_signer_fault_model_unsafe"},
    {"id":"tcb_attestation_freshness","target":"successor:advance_e_0_to_e_1","assumption":"transition_nonce_binding","primitive_failure_class":"attestation_replay","singleton_deletion_error":"epoch_successor_attestation_stale_or_correlated"}
  ],
  "resource_ssa_programs": [
    {
      "id":"native_challenge_resource_flow",
      "nodes":[
        {"id":"n0","kind":"issue","output":"r0","amount":2,"source_authorized":true},
        {"id":"n1","kind":"partition","input":"r0","outputs":{"rA":1,"rB":1}},
        {"id":"n2","kind":"reserve","input":"rA","output":"holdA"},
        {"id":"n3","kind":"consume","input":"holdA","effect_output":"effectA","resource_region":"A"},
        {"id":"n4","kind":"reserve","input":"rB","output":"holdB"},
        {"id":"n5","kind":"release","input":"holdB","output":"rB_released","release_authority":"abort-certificate-B"},
        {"id":"n6","kind":"consume","input":"rB_released","effect_output":"effectB","resource_region":"B"},
        {"id":"n7","kind":"compensate","input":"effectA","settlement_output":"settledA","compensation_authority":"compensate-effect-A","restores_original_capability":false}
      ],
      "concurrency_pairs":[{"left":"n3","right":"n6","linearization_witness":null}],
      "expected_terminal_states":{"effectB":"effect","settledA":"settled"}
    }
  ],
  "active_rewrite_footprints": {
    "partition_flattening": ["resource"],
    "scope_attenuation": ["scope"],
    "support_union": ["support"],
