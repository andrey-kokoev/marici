      "expected_code": "triple_authority_coherence_failure"
    },
    {
      "id": "evidence_preserving_base_change_loses_authority",
      "description": "Chart evidence survives base change while source authority does not.",
      "mutations": [
        {"collection": "transformations", "id": "chart_transport", "field": "preserves_authority", "value": false}
      ],
      "expected_code": "base_change_preserves_evidence_not_authority"
    },
    {
      "id": "factorization_dependent_composite",
