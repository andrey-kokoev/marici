{
  "schema": "marici.authority-grant-composition-hostiles.v1",
  "base_contract": "research/strominger/contracts/authority-grant-composition.v1.json",
  "fixtures": [
    {
      "id": "faithfulness_plus_support_to_observer",
      "description": "Algebraic faithfulness and physical support are laundered into observer authority.",
      "mutations": [
        {"collection": "authority_grants", "id": "g_AB", "field": "authority_kind", "value": "algebraic_faithfulness"},
        {"collection": "authority_grants", "id": "g_BC", "field": "authority_kind", "value": "support"},
        {"collection": "authority_grants", "id": "g_AC", "field": "authority_kind", "value": "observer"}
      ],
      "expected_code": "authority_kind_laundering"
    },
    {
      "id": "two_readouts_to_selector",
      "description": "Two valid readout grants are laundered into selector authority.",
      "mutations": [
        {"collection": "authority_grants", "id": "g_AC", "field": "authority_kind", "value": "selector"}
      ],
      "expected_code": "authority_kind_laundering"
    },
    {
      "id": "completion_ports_to_constructor",
      "description": "A completed readout and executable observation ports are laundered into constructor authority.",
      "mutations": [
        {"collection": "authority_grants", "id": "g_AB", "field": "source_authority_evidence", "value": "topology-bearing completion"},
        {"collection": "authority_grants", "id": "g_BC", "field": "source_authority_evidence", "value": "executable observation ports"},
        {"collection": "authority_grants", "id": "g_AC", "field": "authority_kind", "value": "constructor"}
      ],
      "expected_code": "authority_kind_laundering"
    },
    {
      "id": "pairwise_valid_triple_incoherent",
      "description": "Every pairwise composition remains valid, but the triple associator has nonzero defect.",
      "mutations": [
        {"collection": "associativity_cells", "id": "assoc_ABCD", "field": "coherence_defect", "value": 1}
      ],
      "expected_code": "triple_authority_coherence_failure"
    },
    {
      "id": "evidence_preserving_base_change_loses_authority",
      "description": "Chart evidence survives base change while source authority does not.",
      "mutations": [
        {"collection": "transformations", "id": "chart_transport", "field": "preserves_authority", "value": false}
      ],
      "expected_code": "base_change_preserves_evidence_not_authority"
    },
    {
      "id": "factorization_dependent_composite",
      "description": "Both local factorizations exist, but their result grants live on different evidence domains.",
      "mutations": [
        {"collection": "authority_grants", "id": "g_AD_right", "field": "evidence_domain", "value": "D_transport_B"}
      ],
      "expected_code": "factorization_dependent_composite"
    },
    {
      "id": "representation_change_without_coherence",
      "description": "Changing B to Bprime preserves the boundary process signature but supplies no source-derived coherence cell.",
      "mutations": [
        {"collection": "representation_change_tests", "id": "replace_B_by_Bprime", "field": "coherence_cell", "value": null}
      ],
      "expected_code": "missing_source_derived_representation_coherence"
    },
    {
      "id": "representation_change_strengthens_authority",
      "description": "The alternative presentation silently promotes a readout process to selector authority.",
      "mutations": [
        {"collection": "authority_grants", "id": "g_AC_via_Bprime", "field": "authority_kind", "value": "selector"}
      ],
      "expected_code": "representation_change_strengthens_authority"
    },
    {
      "id": "remove_B_without_direct_source_grant",
      "description": "Removing B destroys the composite because no independently authorized direct A-to-C grant remains.",
      "mutations": [
        {"collection": "representation_change_tests", "id": "remove_B_direct_source_route", "field": "direct_grant", "value": null}
      ],
      "expected_code": "representation_removal_destroys_composite"
    }
  ]
}
