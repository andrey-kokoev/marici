{
  "schema":"marici.scc.model-manifest.v1",
  "model":{
    "id":"face-space-viewer-v1",
    "owner":"marici.Strominger",
    "classification":"cell-local-face-realization-display",
    "stratum":"Forward geometric realization and shared-face attachment transport. One incoming face, three noncoplanar outgoing continuations, generated cell nodes and reflected neighbors. No global tetrahedral tiling, physical particle identity or imported planar transition law.",
    "inputs":["research/strominger/demos/particle-overlap-tetrahedron/face-model.mjs","research/strominger/demos/particle-overlap-tetrahedron/face-space.js","research/strominger/demos/particle-overlap-tetrahedron/face-space.html","research/strominger/demos/particle-overlap-tetrahedron/face-space.css","research/strominger/checkers/check_face_space_viewer.mjs"],
    "checks":[{"id":"local_face_complex_and_browser","path":"research/strominger/checkers/check_face_space_viewer.py","requires":[]}],
    "depends_on":[],
    "consumes":["Operator request to try face-local realization rather than a global vertical R coordinate"],
    "provides":["Three clickable local continuation faces","Exact shared-node attachment and undo","Carrier incidence on generated cells, never detached geometry","Explicit overlap diagnostics"],
    "missing_constructors":["Source-derived C/M role and particle transition law","Global embedding or gluing consistency beyond the local reflection complex"],
    "next_falsifier":"A child moves shared-face vertices, a rendered carrier vertex is not a generated node, undo changes the parent, or an interior overlap is hidden."
  }
