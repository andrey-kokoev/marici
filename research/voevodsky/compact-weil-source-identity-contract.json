{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marici.voevodsky.compact-weil-source-identity-contract.v1",
  "title": "Compact-support Weil source identity contract",
  "type": "object",
  "required": [
    "source_locator",
    "test_space",
    "fourier_convention",
    "quadratic_form_normalization",
    "archimedean_term",
    "prime_translation_terms",
    "polar_endpoint_terms",
    "zero_extension_convention",
    "dirichlet_comparison_map"
  ],
  "properties": {
    "source_locator": {"type": "string", "minLength": 1},
    "test_space": {"const": "compact_logarithmic_support"},
    "fourier_convention": {
      "type": "object",
      "required": ["forward_kernel", "inverse_prefactor", "plancherel_measure"]
    },
    "quadratic_form_normalization": {
      "type": "object",
      "required": ["divisor_counting", "polarization", "overall_prefactor"]
    },
    "archimedean_term": {
      "type": "object",
      "required": ["multiplier", "sign", "prefactor"]
    },
    "prime_translation_terms": {
      "type": "object",
      "required": ["coefficient", "sign", "prefactor", "translation_direction", "adjoint_rule"]
    },
    "polar_endpoint_terms": {
      "type": "object",
      "required": ["rank", "functionals", "signs", "prefactors"]
    },
    "zero_extension_convention": {"type": "string", "minLength": 1},
    "dirichlet_comparison_map": {
      "type": "object",
      "required": ["basis", "matrix_element_rule", "domain_statement"]
    },
    "gaussian_consistency_checks": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
