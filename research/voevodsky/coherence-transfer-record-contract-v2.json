{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marici.voevodsky.coherence-transfer-record-contract.v2",
  "type": "object",
  "required": [
    "id", "source", "target", "map_status", "interface_descriptor",
    "certificate_dependency_poset", "admission_formula", "evidence_backends",
    "minimal_repair_bundles", "demonstrated_strength", "physical_status",
    "prohibited_interpretations", "evidence"
  ],
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string"},
    "target": {"type": "string"},
    "map_status": {"enum": ["proposed", "partially_constructed", "constructed", "falsified", "authority_blocked"]},
    "interface_descriptor": {"type": "object"},
    "certificate_dependency_poset": {
      "type": "object",
      "required": ["predicates", "edges"],
      "properties": {
        "predicates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "edges": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}}
      },
      "additionalProperties": false
    },
    "admission_formula": {"type": "string"},
    "evidence_backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["backend_id", "claim_class", "requirements", "satisfied", "minimal_failures"],
        "properties": {
          "backend_id": {"type": "string"},
          "claim_class": {"enum": ["mathematical", "physical"]},
          "requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "satisfied": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "minimal_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "minimal_repair_bundles": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}},
    "demonstrated_strength": {"type": "string"},
    "physical_status": {"enum": ["not_applicable", "proposed", "blocked", "constructed", "verified"]},
    "prohibited_interpretations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
