    "kernel G-stable",
    "output character decomposition",
    "kernel character decomposition",
    "intertwiner dimension",
    "cutoff compatibility when completed"
  ],
  "finite_fixture": {
    "group": "reciprocal Z2",
    "boundary_rank": 3,
    "kernel_dimension": 7,
    "kernel_plus_dimension": 4,
    "kernel_minus_dimension": 3,
    "output_character": "odd",
