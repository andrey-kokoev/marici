{
  "schema": "marici.gm.principal_cech_descent.v1",
  "edge_supports": {
    "E12": "Spec(Q[u]/(u^2-u+1))",
    "E13": "Spec(Q[u]/(u^2+u-1))",
    "E23": "Spec(Q)"
  },
  "absolute_kahler_differentials": {"E12_over_Q": "0", "E13_over_Q": "0", "E23_over_Q": "0"},
  "common_connection_base": "Q",
  "connection_convention": "column sections; nabla=d+A; quotient row lambda acts on the left",
  "nabla_E": [[0,0,0],[0,0,0],[0,0,0]],
  "nabla_V_on_restricted_principal_fibers": [[0,0,0],[0,0,0],[0,0,0]],
  "delta_pr": [[0,1,0],[0,0,1],[0,-1,1]],
  "d_delta_pr": [[0,0,0],[0,0,0],[0,0,0]],
  "lambda": [1,-1,1],
  "lambda_times_delta_pr": [0,0,0],
  "projected_obstruction_theta": [0,0,0],
  "descent_identity": "nabla_E*delta_pr=delta_pr*nabla_V=0",
  "quotient_connection": "trivial Q-linear connection only",
  "quotient_scalar_form_over_Q": "omega=0",
  "local_monodromy_over_Q": "identity",
  "Q_pole": "none; no positive-dimensional rational one-form exists",
  "gauge_test": "not applicable; omega has no pole and no support-preserving family gauge is defined",
  "singular_divisor": "undefined (the quotient is not a variation over the u,v base)",
  "Q_restrictions": {
    "E12": "-21*u^4, a unit modulo u^2-u+1",
    "E13": "-5*u^4, a unit modulo u^2+u-1",
    "E23": "0"
  },
  "classification": "global Cech vector-space quotient; not an O_B-linear Gauss-Manin quotient line"
}
