{
  "schema": "marici.benincasa.marked_wall_quotient_connection.v1",
  "basis": ["q_top", "q_wall1", "q_wall2"],
  "matrix_pattern": [["alpha",0,0],["beta1","gamma1",0],["beta2",0,"gamma2"]],
  "D": "-4+12*u-6*u*v+4*v-9*u^2+4*u^2*v-v^2",
  "H": "-2-3*u+2*u*v+v-u^2*v+u^3",
  "u": {
    "alpha": "-2*(u-1)/(u*(u-2))",
    "beta1": "-2*(2-3*u+u*v-v)/(u*(u-2)*D)",
    "gamma1": "-(6-9*u+4*u*v-3*v)/D",
    "beta2": "(4-2*v-3*u^2+u^3)/(2*u*(u-2)*H)",
    "gamma2": "-(2-3*u+4*u*v-u*v^2-3*v-3*u^2+2*u^3+v^2)/((u+v-2)*H)"
  },
  "v": {
    "alpha": "-1/(v-2)",
    "beta1": "-(-2+u+v)/((v-2)*(-D))",
    "gamma1": "-(2-3*u-v+2*u^2)/D",
    "beta2": "u*(u-1)/(2*(v-2)*(-H))",
    "gamma2": "(2+3*u-2*u*v-v-2*u^2+u^2*v)/((u+v-2)*H)"
  },
  "checks": {
    "top_diagonals_equal_before_quotient": true,
    "same_sheet_top_relation_horizontal": true,
    "curvature_zero": true
  }
}
