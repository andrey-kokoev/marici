{-# OPTIONS --safe --cubical --guardedness #-}
module SeedCycleVertexConversion where

open import Cubical.Foundations.Prelude hiding (Path)
open import Cubical.Data.Bool.Base using (Bool; true; false)
open import Cubical.Data.Bool.Properties using (true≢false)
open import Cubical.Data.Empty.Base using (⊥)
open import ActualSeedEndpointTable
open import SeedSeamPathComparisonBoundary using (Path; stop; step)
open import SeedFirstReturnActions using (r11)
import SeedArrivalEffects as Arrival
import TableFibrationCycle as Table
import RetainedTetrahedralPackage as Tetra

-- Test the existing tetrahedral constructor, rather than interpreting its
-- vertex projection as a new state-changing map.
module Existing {ℓ : Level} (X : Type ℓ) where
  module C = Tetra.Cells X
  input-vertex : C.Request → C.Vertex → X
  input-vertex (v , h) C.zero = C.Vertices.v0 v
  input-vertex (v , h) C.one = C.Vertices.v1 v
  input-vertex (v , h) C.two = C.Vertices.v2 v
  input-vertex (v , h) C.three = C.Vertices.v3 v
  vertex-after-completion : (q : C.Request) (i : C.Vertex)
    → C.vertex (C.build q) i ≡ input-vertex q i
  vertex-after-completion q C.zero = refl
  vertex-after-completion q C.one = refl
  vertex-after-completion q C.two = refl
  vertex-after-completion q C.three = refl

-- Explicit new bookkeeping adapter at marked A. It does not assert a
-- tetrahedral filler for the free seed, or an equality cycle = empty path.
record AtA : Type₁ where
  constructor at-A
  field
    retained-source : Table.Table Occurrence Vertex Vertex
    source-agrees : retained-source ≡ seed
    initial : Arrival.Arrival A
    cycle : Path A A
    active : Arrival.Arrival A
    computation : Arrival.Read.run cycle initial ≡ active

convert : (p : Path A A) → Arrival.Arrival A → AtA
convert p a = at-A seed refl a p (Arrival.Read.run p a) refl
before after : Arrival.Arrival A → AtA
before = convert stop
after = convert r11

retains-source : (a : Arrival.Arrival A) → AtA.retained-source (after a) ≡ seed
retains-source a = refl
retains-cycle : (a : Arrival.Arrival A) → AtA.cycle (after a) ≡ r11
retains-cycle a = refl
retains-initial : (a : Arrival.Arrival A) → AtA.initial (after a) ≡ a
retains-initial a = refl
arrival-after : (a : Arrival.Arrival A) → AtA.active (after a) ≡ (CA , refl)
arrival-after a = refl

nonempty : {s t : Vertex} → Path s t → Bool
nonempty stop = false
nonempty (step e rest) = true

-- Conversion changes the marked package through its retained cycle, even
-- when the starting active arrival already equals CA.
package-changed : (a : Arrival.Arrival A) → before a ≡ after a → ⊥
package-changed a p = true≢false (sym (cong (λ s → nonempty (AtA.cycle s)) p))

-- But the existing last-arrival reader ignores that memory on the next
-- supplied outward traversal. Neither a routing selector nor a response
-- coupling has been generated by this conversion.
next-AB-unchanged : (a : Arrival.Arrival A)
  → Arrival.arrive AB (AtA.active (before a)) ≡ Arrival.arrive AB (AtA.active (after a))
next-AB-unchanged a = refl
next-AD-unchanged : (a : Arrival.Arrival A)
  → Arrival.arrive AD (AtA.active (before a)) ≡ Arrival.arrive AD (AtA.active (after a))
next-AD-unchanged a = refl
