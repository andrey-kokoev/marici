{-# OPTIONS --safe --cubical --guardedness #-}
module TickQuotientContinuity where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ)
open import Cubical.Data.Bool.Base using (Bool)
open import Cubical.Data.Sigma using (_×_; Σ-syntax)
open import Cubical.HITs.PropositionalTruncation as PT
open import Cubical.HITs.SetQuotients using ([_])
open import RegularCauchyStructure
open import CauchyMetricEquivalence
open import CauchyQuantitativeContinuity
open import TickCompletionRealization
open import TickCompletionContinuity

-- A quotient-level entourage generated by eventual precision bounds.
-- Witnesses are truncated: no choice of Cauchy representative is exposed.
-- This defines the closeness notion used below; no equivalence to an
-- independently defined metric or topology is assumed.
CompletionNear : ℕ → MetricCompletionCandidate → MetricCompletionCandidate → Type
CompletionNear k u v = ∥ Σ[ x ∈ RegularCauchy ] Σ[ y ∈ RegularCauchy ]
  (([ x ] ≡ u) × (([ y ] ≡ v) × EventuallyWithin x y k)) ∥₁

record CompletionContinuous
  (F : MetricCompletionCandidate → MetricCompletionCandidate) : Type where
  field
    precision-modulus : ℕ → ℕ
    preserves-near : (u v : MetricCompletionCandidate) (k : ℕ)
      → CompletionNear (precision-modulus k) u v → CompletionNear k (F u) (F v)
open CompletionContinuous public

-- Descent theorem: an exact commuting square plus quantitative continuity
-- on representatives yields continuity of the actual completion function.
descend-continuity :
  (f : RegularCauchy → RegularCauchy)
  (F : MetricCompletionCandidate → MetricCompletionCandidate)
  → QuantitativelyContinuous f
  → ((x : RegularCauchy) → [ f x ] ≡ F [ x ])
  → CompletionContinuous F
precision-modulus (descend-continuity f F continuous agrees) = modulus continuous
preserves-near (descend-continuity f F continuous agrees) u v k = PT.map
  λ { (x , y , px , py , close) →
    f x , f y ,
    (agrees x ∙ cong F px) ,
    (agrees y ∙ cong F py) ,
    preservesEventuallyWithin continuous x y k close }

left-completion-continuous : (q j : Bool × Bool)
  → CompletionContinuous (λ a → Realization.leg Realization.L a (Realization.basis q) j)
left-completion-continuous q j = descend-continuity
  (left-coordinate q j)
  (λ a → Realization.leg Realization.L a (Realization.basis q) j)
  (left-coordinate-continuous q j) (left-coordinate-correct q j)

right-completion-continuous : (q j : Bool × Bool)
  → CompletionContinuous (λ a → Realization.leg Realization.R a (Realization.basis q) j)
right-completion-continuous q j = descend-continuity
  (right-coordinate q j)
  (λ a → Realization.leg Realization.R a (Realization.basis q) j)
  (right-coordinate-continuous q j) (right-coordinate-correct q j)
