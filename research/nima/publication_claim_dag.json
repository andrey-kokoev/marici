  "claims": [
    {
      "id": "C-LOWERING",
      "status": "established",
      "text": "Differential operators in scalar-scaffold variables extract planar phi^3 diagrams and Catalan mixed-amplitude modules.",
      "sources": [
        "P-X01"
      ]
    },
    {
      "id": "C-REVERSE-LS",
      "status": "established",
      "text": "On-shell pure-gluon gluing recovers surface curve-covering combinatorics at leading singularities/maximal residues.",
      "sources": [
        "P-X02"
      ]
    },
    {
      "id": "C-HZ-CONDITIONAL",
      "status": "established",
      "text": "Hidden-zero reconstruction is conditional and does not by itself prove completeness for unknown theories.",
      "sources": [
        "P-X03"
      ]
    },
    {
      "id": "C-SPIN2-KERNEL",
      "status": "established",
      "text": "Two standard five-point splitting loci leave a genuine kernel once both channels allow spin-2 exchange.",
      "sources": [
        "P-X04"
      ]
    },
    {
      "id": "C-IST-FAMILY",
      "status": "established",
      "text": "Hidden-zero and splitting conditions admit infinite-spin-tower amplitude families under the studied analytic assumptions.",
      "sources": [
        "P-X05"
      ]
    },
    {
      "id": "L-OP-ALGEBRA",
      "status": "conjectural",
      "text": "The scalar surface theory carries a closed raising/lowering/sewing/pairing operator algebra.",
      "sources": [
        "P-X01",
        "P-X02"
      ]
    },
    {
      "id": "L-TYPED-RECOGNITION",
      "status": "conjectural",
      "text": "Cuts, zeros and boundary behavior may determine amplitudes only after an explicit admissibility class is fixed.",
      "sources": [
        "P-X03",
        "P-X04",
        "P-X05"
      ]
    }
  ],
