{
  "schema": "marici.coherence.two-sided-block-observer-model.v1",
  "rho": "3/5",
  "cases": 100,
  "all_exact": true,
  "left_boundary": "past before first event = 0",
  "right_boundary": "future after last event = 0",
  "past_recurrence": "P_n=u_n+rho P_(n-1)",
  "future_recurrence": "F_n=u_n+rho F_(n+1)",
  "local_consistency": "u_n=P_n-rho P_(n-1)=F_n-rho F_(n+1)",
  "reflection": "reverses events and swaps past/future tails"
}
