{
  "schema": "marici.coherence.boundary-pfaffian-constructor-alphabet.v2",
  "supersedes": "marici.coherence.boundary-pfaffian-constructor-alphabet.v1",
  "scope": "ordered Pfaffian residuals plus second-order Green graph recollement",
  "objects": [
    "oriented_residual_line",
    "stationary_hyperbolic_double",
    "piecewise_h2_graph_fiber",
    "value_jump_line_odd",
    "flux_jump_line_even",
    "finite_green_state",
    "labelled_flux_family",
    "green_determinant_line",
    "pfaffian_line"
  ],
  "constructors": [
    {"id":"translate","source":"stationary_hyperbolic_double","target":"stationary_hyperbolic_double","action":"diag(z,z^-1)"},
    {"id":"reverse","source":"stationary_hyperbolic_double","target":"stationary_hyperbolic_double","action":"swap(in,out)"},
    {"id":"ordered_sew","source":"oriented_residual_line_pair","target":"pfaffian_line","action":"q_out(left) gap q_in(right)"},
    {"id":"refine_seam","source":"piecewise_h2_graph_fiber_B","target":"piecewise_h2_graph_fiber_B_union_c","cofiber":"value_jump_line_odd plus flux_jump_line_even"},
    {"id":"massive_apply","source":"finite_green_state_S","target":"labelled_flux_family_S","action":"kernel coefficient u_c maps to flux jump -2u_c"},
    {"id":"green_resolve","source":"value_flux_seam_family","target":"stationary_hyperbolic_double","action":"sum of position-dependent Green transfer matrices"},
    {"id":"endpoint_moments","source":"labelled_flux_family","target":"stationary_hyperbolic_double","action":"J maps to weighted reciprocal/direct moments"},
    {"id":"include_contexts","source":"finite_green_state_S","target":"finite_green_state_T","condition":"S subset T","action":"isometric kernel-span inclusion"},
    {"id":"project_contexts","source":"finite_green_state_T","target":"finite_green_state_S","condition":"S subset T","action":"Green orthogonal projection"},
    {"id":"green_determinant_transition","source":"green_determinant_line_S","target":"green_determinant_line_T","action":"multiply by innovation norm squared"},
    {"id":"paired_pfaffian_transition","source":"pfaffian_line_even_S","target":"pfaffian_line_even_T","condition":"T adds two ordered points","action":"multiply by internal gap or its inverse according to pair parity"}
  ],
  "relations": [
    {"id":"dihedral_relation","law":"R T(z) R = T(z^-1)"},
    {"id":"seam_reflection_parity","law":"(value,flux) maps to (-value,flux)"},
    {"id":"massive_green_factorization","law":"endpoint_moments o massive_apply = direct Green asymptotic observation"},
    {"id":"green_transfer_covariance","law":"green_resolve intertwines seam relocation/reflection with translate/reverse"},
    {"id":"ind_pro_triangle","law":"project(S,T) project(T,U) = project(S,U)"},
    {"id":"state_retraction","law":"project(S,T) include(S,T) = identity"},
    {"id":"determinant_cocycle","law":"det_transition(S,U) = det_transition(T,U) det_transition(S,T)"},
    {"id":"moment_kernel_stability","law":"two-moment kernel is stable under assembly, translation, and reflection"}
  ],
  "protocols": {
    "stationary_endpoint": ["translate","reverse","endpoint_moments"],
    "ordered_pfaffian": ["ordered_sew","paired_pfaffian_transition"],
    "green_ind_pro": ["include_contexts","project_contexts","green_determinant_transition"],
    "second_order_recollement": ["refine_seam","massive_apply","green_resolve"]
  },
  "forbidden_collapses": [
    "identify_value_jump_line_odd_with_flux_jump_line_even",
    "identify_green_determinant_line_with_pfaffian_line",
    "discard_labelled_fluxes_before_endpoint_only_protocol_is_declared",
    "infer_uniform approximation from small unnormalized innovation norm",
    "treat a section of endpoint_moments as equivariant",
    "identify equal-rank two-dimensional carriers without the Green transfer"
  ]
}
