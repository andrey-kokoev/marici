{
  "schema": "marici.coherence.boundary-pfaffian-constructor-alphabet.v2",
  "supersedes": "marici.coherence.boundary-pfaffian-constructor-alphabet.v1",
  "scope": "ordered Pfaffian residuals plus second-order Green graph recollement",
  "coefficient_regimes": {
    "ring_generic": "commutative ring",
    "localized_selected_gaps": "every selected Pfaffian pair weight has an explicit unit witness",
    "green_normalized": "commutative algebra with an explicit inverse of two"
  },
  "objects": [
    "oriented_residual_line",
    "stationary_hyperbolic_double",
    "piecewise_h2_graph_fiber",
    "value_jump_line_odd",
    "flux_jump_line_even",
    "finite_green_state",
    "labelled_flux_family",
    "green_determinant_line",
    "pfaffian_line",
    "integral_alternating_torsion_module",
    "primitive_odd_null_line"
  ],
  "constructors": [
    {"id":"translate","source":"stationary_hyperbolic_double","target":"stationary_hyperbolic_double","action":"diag(z,z^-1)"},
    {"id":"reverse","source":"stationary_hyperbolic_double","target":"stationary_hyperbolic_double","action":"swap(in,out)"},
    {"id":"ordered_sew","source":"oriented_residual_line_pair","target":"pfaffian_line","action":"q_out(left) gap q_in(right)","coefficient_regime":"ring_generic"},
    {"id":"refine_seam","source":"piecewise_h2_graph_fiber_B","target":"piecewise_h2_graph_fiber_B_union_c","cofiber":"value_jump_line_odd plus flux_jump_line_even"},
    {"id":"massive_apply","source":"finite_green_state_S","target":"labelled_flux_family_S","action":"kernel coefficient u_c maps to flux jump -2u_c","coefficient_regime":"ring_generic"},
    {"id":"green_resolve","source":"value_flux_seam_family","target":"stationary_hyperbolic_double","action":"sum of position-dependent Green transfer matrices","coefficient_regime":"green_normalized"},
    {"id":"endpoint_moments","source":"labelled_flux_family","target":"stationary_hyperbolic_double","action":"J maps to weighted reciprocal/direct moments"},
    {"id":"include_contexts","source":"finite_green_state_S","target":"finite_green_state_T","condition":"S subset T","action":"isometric kernel-span inclusion"},
    {"id":"project_contexts","source":"finite_green_state_T","target":"finite_green_state_S","condition":"S subset T","action":"Green orthogonal projection"},
    {"id":"green_determinant_transition","source":"green_determinant_line_S","target":"green_determinant_line_T","action":"multiply by innovation norm squared"},
    {"id":"paired_pfaffian_correspondence","source":"common_remaining_factor","target":"pfaffian_line_even_S_pair_even_T","condition":"T adds two ordered points","action":"r maps to (r rho,r alpha beta) for a selected gap; the image satisfies rho tau_new = alpha beta tau_old","coefficient_regime":"ring_generic"},
    {"id":"paired_pfaffian_transition","source":"pfaffian_line_even_S","target":"pfaffian_line_even_T","condition":"T adds two ordered points","action":"multiply by internal gap or its inverse according to pair parity","coefficient_regime":"localized_selected_gaps"},
    {"id":"integral_torsion_reconcile","source":"integral_chain_skew_form","target":"integral_alternating_torsion_module plus primitive_odd_null_line","action":"compute Pfaffian divisors D_k and elementary divisors d_k=D_k/D_(k-1)","coefficient_regime":"ring_generic"},
    {"id":"localize_torsion","source":"integral_alternating_torsion_module","target":"localized_contractible_pairs","action":"invert selected gaps; all alternating elementary divisors become units","coefficient_regime":"localized_selected_gaps"},
    {"id":"tropical_torsion_update","source":"graded_two_boundary_state_family_n plus prime_gap_valuation","target":"graded_two_boundary_state_family_n_plus_1","action":"Z'_k=min(Z_k,O_k); O'_k=Z_(k-1)+c","coefficient_regime":"ring_generic"},
    {"id":"tail_observe","source":"finite_green_state plus labelled_cutoff_i","target":"scalar","action":"restrict to j>=i then apply y_i times the reciprocal endpoint moment","coefficient_regime":"green_normalized"}
  ],
  "relations": [
    {"id":"dihedral_relation","law":"R T(z) R = T(z^-1)","evidence":"dihedral-context-hankel-stabilization.v1.json"},
    {"id":"seam_reflection_parity","law":"(value,flux) maps to (-value,flux)","evidence":"value-flux-seam-symmetry.v1.json"},
    {"id":"massive_green_factorization","law":"endpoint_moments o massive_apply = direct Green asymptotic observation","evidence":"finite-context-realization-factorization.v1.json"},
    {"id":"green_transfer_covariance","law":"green_resolve intertwines seam relocation/reflection with translate/reverse","evidence":"seam-to-asymptotic-green-transfer.v1.json","coefficient_obstruction_evidence":"characteristic-two-seam-transfer-obstruction.v1.json"},
    {"id":"ind_pro_triangle","law":"project(S,T) project(T,U) = project(S,U)","evidence":"green-gram-pro-system.v1.json"},
    {"id":"state_retraction","law":"project(S,T) include(S,T) = identity","evidence":"green-gram-pro-system.v1.json"},
    {"id":"determinant_cocycle","law":"det_transition(S,U) = det_transition(T,U) det_transition(S,T)","evidence":"green-gram-determinant-transitions.v1.json"},
    {"id":"paired_pfaffian_correspondence","law":"two-point refinement is presented by a common remaining factor and satisfies the cross-multiplied relation","evidence":"ring-generic-paired-pfaffian-correspondence.v1.json","obstruction_evidence":"nonunit-pfaffian-correspondence-fibers.v1.json","formal_evidence":"../voevodsky/agda/BoundaryPfaffianResidualFold.agda"},
    {"id":"paired_pfaffian_transition","law":"two-point refinement multiplies Pfaffian torsion by the parity-selected internal factor after localization","evidence":"paired-refinement-line-transitions.v1.json"},
    {"id":"moment_kernel_stability","law":"two-moment kernel is stable under assembly, translation, and reflection","evidence":"multiseam-asymptotic-quotient.v1.json","formal_evidence":"../voevodsky/agda/BoundaryPfaffianFluxMomentQuotient.agda"},
    {"id":"integral_pfaffian_divisor_classification","law":"alternating Smith factors are d_k=D_k/D_(k-1), with odd cofactor gcd controlling primitive null scaling","evidence":"integral-chain-pfaffian-divisors.v1.json"},
    {"id":"graded_tropical_recurrence","law":"prime-local divisor spectra update with two boundary states per grade and coupling from grade k-1 to k","evidence":"streaming-tropical-torsion-recurrence.v1.json"},
    {"id":"tail_observer_duality","law":"normalized one-sided Green tails are exactly dual to Markov state innovations","evidence":"canonical-green-dual-observers.v1.json"}
  ],
  "protocols": {
    "stationary_endpoint": ["translate","reverse","endpoint_moments"],
    "ordered_pfaffian": ["ordered_sew","paired_pfaffian_correspondence","paired_pfaffian_transition"],
    "integral_reconciliation": ["integral_torsion_reconcile","tropical_torsion_update","localize_torsion"],
    "green_ind_pro": ["include_contexts","project_contexts","green_determinant_transition","tail_observe"],
    "second_order_recollement": ["refine_seam","massive_apply","green_resolve"]
  },
  "forbidden_collapses": [
    "identify_value_jump_line_odd_with_flux_jump_line_even",
    "identify_green_determinant_line_with_pfaffian_line",
    "discard_labelled_fluxes_before_endpoint_only_protocol_is_declared",
    "infer_uniform approximation from small unnormalized innovation norm",
    "treat a section of endpoint_moments as equivariant",
    "identify equal-rank two-dimensional carriers without the Green transfer",
    "apply normalized Green transfer when two is not invertible",
    "claim adjacent hyperbolic contractibility without selected-gap unit witnesses",
    "replace integral alternating torsion module by its terminal Pfaffian product"
  ]
}
