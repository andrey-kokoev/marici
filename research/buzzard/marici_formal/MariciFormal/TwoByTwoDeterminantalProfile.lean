import MariciFormal.CoefficientRegimeBoundary

/-!
For two-by-two matrices, the ideals of one-by-one and two-by-two minors form a
nested determinantal profile. The running fixtures agree only at the top stage.
-/

namespace MariciFormal

variable {R : Type*} [CommRing R]

/-- The ideal generated by the unique two-by-two minor, the determinant. -/
noncomputable def secondDeterminantalIdeal (matrix : Matrix (Fin 2) (Fin 2) R) :
    Ideal R :=
  Ideal.span ({matrix.det} : Set R)

/-- The two stages of determinantal data for a two-by-two matrix. -/
structure TwoByTwoDeterminantalProfile (R : Type*) [CommRing R] where
  first : Ideal R
  second : Ideal R

noncomputable def twoByTwoDeterminantalProfile
    (matrix : Matrix (Fin 2) (Fin 2) R) : TwoByTwoDeterminantalProfile R where
  first := matrixEntryIdeal matrix
  second := secondDeterminantalIdeal matrix

/-- The determinant ideal is contained in the entry ideal. -/
theorem secondDeterminantalIdeal_le_matrixEntryIdeal
    (matrix : Matrix (Fin 2) (Fin 2) R) :
    secondDeterminantalIdeal matrix ≤ matrixEntryIdeal matrix := by
  rw [secondDeterminantalIdeal, Ideal.span_le]
  intro polynomial hpolynomial
  simp only [Set.mem_singleton_iff] at hpolynomial
  subst polynomial
  rw [Matrix.det_fin_two]
  exact (matrixEntryIdeal matrix).sub_mem
    (Ideal.mul_mem_right (matrix 1 1) (matrixEntryIdeal matrix)
      (matrixEntry_mem matrix 0 0))
    (Ideal.mul_mem_right (matrix 1 0) (matrixEntryIdeal matrix)
      (matrixEntry_mem matrix 0 1))

theorem fixture_secondDeterminantalIdeals_agree :
    secondDeterminantalIdeal separateAxisMatrix =
      secondDeterminantalIdeal productAxisMatrix := by
  simp only [secondDeterminantalIdeal]
  rw [determinantPolynomials_agree.1, determinantPolynomials_agree.2]

theorem fixture_firstDeterminantalIdeals_differ :
    matrixEntryIdeal separateAxisMatrix ≠ matrixEntryIdeal productAxisMatrix := by
  rw [← bivariate_firstDeterminantalIdeal_eq_matrixEntryIdeal,
    ← bivariate_firstDeterminantalIdeal_eq_matrixEntryIdeal,
    productAxis_firstDeterminantalIdeal_eq_top]
  exact separateAxis_firstDeterminantalIdeal_ne_top

/-- Equal top-minor ideals do not determine the complete two-stage profile. -/
theorem fixture_profiles_differ_despite_equal_topStage :
    secondDeterminantalIdeal separateAxisMatrix =
        secondDeterminantalIdeal productAxisMatrix ∧
      twoByTwoDeterminantalProfile separateAxisMatrix ≠
        twoByTwoDeterminantalProfile productAxisMatrix := by
  refine ⟨fixture_secondDeterminantalIdeals_agree, ?_⟩
  intro hprofile
  exact fixture_firstDeterminantalIdeals_differ
    (congrArg TwoByTwoDeterminantalProfile.first hprofile)

end MariciFormal
