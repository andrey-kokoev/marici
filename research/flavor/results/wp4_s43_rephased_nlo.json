  "R_beta_times_exp_minus_i_phi": "d13*d33*u33*(d23**2*d33**2*epsilon**2 + 2*d32**4 + 4*d32**2*d33**2 + 2*d33**4)/(2*u13*(d32**6 + 3*d32**4*d33**2 + 3*d32**2*d33**4 + d33**6))",
