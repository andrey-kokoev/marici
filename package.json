{
  "name": "marici",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "source:assemble": "node scripts/assemble-narada-source.mjs",
    "source:check": "node scripts/assemble-narada-source.mjs --check",
    "graph:project": "node scripts/project-public-epistemic-graph.mjs",
    "graph:test": "node scripts/test-public-epistemic-graph.mjs",
    "graph:test:e2e": "playwright test tests/graph.spec.mjs",
    "graph:test:live": "playwright test tests/graph.spec.mjs --config playwright.live.config.mjs",
    "frontier:check": "node scripts/check-frontier-atlas.mjs",
    "bootstrap": "node scripts/assemble-narada-source.mjs && pnpm install",
    "build:ui": "pnpm --filter @narada-core/ui build",
    "dev": "pnpm run build:ui && astro dev",
    "math:check": "node scripts/check-katex.mjs source",
    "math:check:dist": "node scripts/check-katex.mjs dist",
    "check": "pnpm run math:check && pnpm run build:ui && astro check",
    "build": "pnpm run math:check && pnpm run build:ui && astro build && pnpm run math:check:dist",
    "preview": "astro preview",
    "ship": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@narada-core/ui": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@playwright/test": "^1.62.1",
    "astro": "7.1.3",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "wrangler": "4.114.0"
  }
}
