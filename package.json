{
  "name": "marici",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "source:assemble": "node scripts/assemble-narada-source.mjs",
    "stacks:search": "node scripts/stacks-search.mjs",
    "pdf:search": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File references/pdf-search.ps1",
    "pdf:reindex": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File references/pdf-search.ps1 -Rebuild",
    "source:check": "node scripts/assemble-narada-source.mjs --check",
    "graph:snapshot": "node scripts/snapshot-epistemic-ledger.mjs",
    "graph:project": "pnpm run graph:snapshot && node scripts/project-public-epistemic-graph.mjs",
    "graph:test": "node scripts/test-public-epistemic-graph.mjs",
    "nets:prepare": "node scripts/prepare-conjecture-nets.mjs",
    "nets:check": "node scripts/prepare-conjecture-nets.mjs --check",
    "nets:test": "node --test tests/conjecture-nets.test.mjs",
    "nets:test:browser": "node scripts/test-conjecture-nets-browser.mjs",
    "graph:test:e2e": "playwright test tests/graph.spec.mjs",
    "graph:test:live": "playwright test tests/graph.spec.mjs --config playwright.live.config.mjs",
    "verify:snapshots": "playwright test tests/verify-snapshots.spec.mjs --config playwright.live.config.mjs",
    "frontier:check": "node scripts/check-frontier-atlas.mjs",
    "oddballs:check": "node scripts/check-oddball-observatory.mjs",
    "bootstrap": "node scripts/assemble-narada-source.mjs && pnpm install",
    "predev": "node scripts/prepare-website.mjs",
    "dev": "vitepress dev website",
    "pyramid:dev": "node public/experiments/eight-node-coherence-pyramid/dev-server.mjs",
    "threejs:prepare": "node scripts/prepare-threejs-reference.mjs",
    "normal-ray:prepare": "node scripts/prepare-normal-ray.mjs",
    "normal-ray:inspect": "node scripts/inspect-process3.mjs",
    "normal-ray:test": "node --test tests/normal-ray.test.mjs tests/diamond-construction.test.mjs && node scripts/test-normal-ray.mjs",
    "planes:prepare": "node scripts/prepare-tetrahedral-planes.mjs",
    "lattice:prepare": "node scripts/prepare-realization-lattice.mjs",
    "lattice:dev": "vite examples/realization-lattice --host 127.0.0.1",
    "lattice:test": "node scripts/prepare-helium-carriers.mjs --check && node --test tests/realization-lattice.test.mjs tests/realization-lattice-helium.test.mjs && node scripts/test-realization-lattice.mjs",
    "planes:test": "node --test tests/tetrahedral-planes.test.mjs && node scripts/test-tetrahedral-planes.mjs",
    "threejs:test": "node --test tests/threejs-panel.test.mjs && node scripts/test-threejs-reference.mjs",
    "math:check": "node scripts/check-katex.mjs source",
    "math:check:dist": "node scripts/check-katex.mjs dist",
    "build": "node scripts/prepare-website.mjs && vitepress build website && pagefind --site website/.vitepress/dist",
    "preview": "vitepress preview website",
    "research:check": "node scripts/check-research-lab.mjs",
    "research:check:live": "node scripts/check-research-lab.mjs --live",
    "cleanup:aged": "pwsh -NoLogo -NoProfile -File scripts/cleanup-aged.ps1",
    "ship": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "1.0.2",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "d3": "7.9.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "markdown-it": "^14.1.0",
    "pagefind": "1.5.2",
    "three": "0.180.0",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitepress": "1.6.4",
    "vue": "3.5.43",
    "wrangler": "4.114.0"
  }
}
