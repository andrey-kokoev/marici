---
import SiteLayout from '../layouts/SiteLayout.astro'
import { getPublishedLedger } from '../lib/ledger'

const records = await getPublishedLedger()
---
<SiteLayout
  title="The Resident's Ledger · Marici"
  description="Published research ledger entries with explicit author attribution, keeping claims and boundaries together."
>
  <section class="ledger-page" aria-labelledby="ledger-title">
    <p class="eyebrow">The Resident's Ledger</p>
    <h1 id="ledger-title">Research ledger</h1>
    <p class="lede">
      Marici authors record the research as numbered entries. The ledger keeps established structure,
      strong inference, open questions, and prohibited overclaims on the same public surface.
    </p>
    <p class="ledger-count">{records.length} published entries · corrections remain new entries.</p>

    <div id="search" style="margin-block:1.5rem;"></div>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
    <script src="/pagefind/pagefind-ui.js" type="text/javascript" defer></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        new PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
      });
    </script>

    <section class="article-list" aria-label="Ledger entries">
      {records.map(({ meta }) => (
        <a class="article-card" href={'/ledger/' + meta.slug + '/'}>
          <div class="article-meta">
            <span class="entry-no">Entry {String(meta.entry).padStart(3, '0')}</span>
          </div>
          <h2>{meta.title}</h2>
          <p>{meta.description}</p>
          <p class="ledger-status-inline">Published source entry · {meta.kind}</p>
          <div class="article-meta">
            <time datetime={meta.publishedAt.toISOString()}>{meta.publishedAt.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}</time>
            <span>Read entry →</span>
          </div>
        </a>
      ))}
    </section>
  </section>
</SiteLayout>

<style is:global>
  .ledger-page h1 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -.03em; line-height: 1.15; }

  /* Pagefind dark-mode overrides */
  #search { --pagefind-ui-background: var(--panel); --pagefind-ui-text: var(--ink); --pagefind-ui-border: var(--line); --pagefind-ui-primary: var(--ochre); --pagefind-ui-tag: var(--panel-raised); }

  /* Pagefind clear button — lose the 90s box */
  #search .pagefind-ui__search-clear { background: transparent; border: none; font-size: .85rem; font-weight: 450; opacity: .55; transition: opacity .15s; padding: 0 14px; top: 0; right: 3px; border-radius: 0; }
  #search .pagefind-ui__search-clear:hover { opacity: 1; }
</style>
