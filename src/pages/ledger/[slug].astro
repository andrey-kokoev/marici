---
import { createMarkdownProcessor, markdownConfigDefaults } from '@astrojs/markdown-remark'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { getPublishedLedger } from '../../lib/ledger'
import remarkMath from 'remark-math'
import remarkNaradaMath from '../../lib/remark-narada-math.mjs'
import rehypeKatex from 'rehype-katex'

const processor = await createMarkdownProcessor({
  ...markdownConfigDefaults,
  remarkPlugins: [remarkMath, remarkNaradaMath],
  rehypePlugins: [rehypeKatex],
})

export async function getStaticPaths() {
  const records = await getPublishedLedger()
  return records.map((record, index) => ({
    params: { slug: record.meta.slug },
    props: {
      record,
      prev: records[index - 1]?.meta,
      next: records[index + 1]?.meta,
    },
  }))
}

const { record, prev, next } = Astro.props
const allRecords = await getPublishedLedger()
const slugByEntry = new Map(allRecords.map((r) => [r.meta.entry, r.meta.slug]))

function stripH1(body: string) {
  return body.replace(/^#\s+[^\r\n]+(?:\r?\n)+/, '')
}

function convertTexMath(body: string) {
  // Source files use \( ... \) and \\[ ... \\] for math delimiters.
  // remark-math understands $ ... $ and $$ ... $$, so convert before render.
  return body
    .replace(/^(\s*)\\\[[ \t]*$/gm, '$1$$')
    .replace(/^(\s*)\\\][ \t]*$/gm, '$1$$')
    .replace(/\\\((.*?)\\\)/g, '$$$1$$')
}

function linkEntryRefs(body: string) {
  // Evidence bullets refer to other ledger entries as "entry 93" or
  // "entries 129--131". Turn those numbers into links.
  return body.replace(
    /\b(entry|entries)\s+(\d{1,3})(?:\s*--\s*(\d{1,3}))?\b/gi,
    (match, word, start, end) => {
      const startNum = Number(start)
      const endNum = end ? Number(end) : startNum
      const link = (n: number) => {
        const slug = slugByEntry.get(n)
        if (!slug) return String(n)
        return `<a href="/ledger/${slug}/">${n}</a>`
      }
      if (endNum === startNum) {
        return `${word} ${link(startNum)}`
      }
      return `${word} ${link(startNum)}--${link(endNum)}`
    },
  )
}

const GITHUB_REPO_ROOT = 'https://github.com/andrey-kokoev/marici/blob/main'

function linkFileRefs(body: string) {
  // Turn repo-relative file paths into GitHub links, but skip paths inside
  // fenced code blocks where the literal path is part of the data.
  const segments: { fenced: boolean; text: string }[] = []
  let lastIndex = 0
  const fenceRe = /^(?:```|~~~)[\s\S]*?^(?:```|~~~)/gm
  let match: RegExpExecArray | null
  while ((match = fenceRe.exec(body)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ fenced: false, text: body.slice(lastIndex, match.index) })
    }
    segments.push({ fenced: true, text: match[0] })
    lastIndex = match.index + match[0].length
  }
  if (lastIndex < body.length) {
    segments.push({ fenced: false, text: body.slice(lastIndex) })
  }

  const fileRefRe = /(`?)((?:research|src)\/[\w/.-]+?\.(?:rs|py|mjs|md))\1/g
  return segments
    .map(({ fenced, text }) => {
      if (fenced) return text
      return text.replace(fileRefRe, (_, backtick, filePath) => {
        const url = `${GITHUB_REPO_ROOT}/${filePath}`
        return `[${backtick}${filePath}${backtick}](${url})`
      })
    })
    .join('')
}

const transformedBody = linkEntryRefs(linkFileRefs(convertTexMath(stripH1(record.entry.body ?? ''))))
const { code: html } = await processor.render(transformedBody)
---
<SiteLayout
  title={record.meta.title + ' · Marici'}
  description={record.meta.description}
>
  <article class="article ledger-entry">
    <nav class="article-nav" aria-label="Ledger navigation">
      {prev
        ? <a class="article-nav-link prev" href={'/ledger/' + prev.slug + '/'}><span class="arrow" aria-hidden="true">&larr;</span><span class="nav-label">Previous</span><span class="nav-title">{prev.title}</span></a>
        : <span class="article-nav-link prev disabled" aria-hidden="true"></span>}
      {next
        ? <a class="article-nav-link next" href={'/ledger/' + next.slug + '/'}><span class="nav-label">Next</span><span class="nav-title">{next.title}</span><span class="arrow" aria-hidden="true">&rarr;</span></a>
        : <span class="article-nav-link next disabled" aria-hidden="true"></span>}
    </nav>

    <header class="article-header">
      <p class="eyebrow">The Resident's Ledger · Entry {String(record.meta.entry).padStart(3, '0')}</p>
      <h1>{record.meta.title}</h1>
      <p class="lede">{record.meta.description}</p>
      <div class="article-meta">
        <time datetime={record.meta.publishedAt.toISOString()}>{record.meta.publishedAt.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>
        <span class="tag">{record.meta.kind}</span>
      </div>
    </header>

    <dl class="ledger-status" aria-label="Publication status">
      <div><dt>Publication</dt><dd>Published</dd></div>
      <div><dt>Entry</dt><dd>{String(record.meta.entry).padStart(3, '0')}</dd></div>
      <div><dt>Authors</dt><dd>{record.meta.authorLabel}</dd></div>
      <div><dt>Source</dt><dd>src/ledger</dd></div>
    </dl>

    <div class="article-body" set:html={html} />
  </article>
</SiteLayout>
