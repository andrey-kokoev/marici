---
import SiteLayout from '../../layouts/SiteLayout.astro'
import katex from 'katex'

const physics = [
  { domain: 'Quantum mechanics', slug: 'quantum-mechanics', status: 'Established', connection: 'Born rule from rank-1 factorization of the overlap matrix G_ij = psi_i* psi_j. N-path interference from I = sum G_ij exp(i(theta_j - theta_i)). Entanglement from overlap non-separability.' },
  { domain: 'General relativity', slug: 'general-relativity', status: 'Established', connection: 'Spatial metric from stabilizer overlaps g_ab(p) = G_ab. ADM constraints close on finite carrier with (+++-) signature. Continuum limit delta(x,y) constructed.' },
  { domain: 'SM gauge group', slug: 'sm-gauge-group', status: 'Established', connection: 'SU(3) x SU(2) x U(1) from S4 irrep decomposition (1+1+2). S3 stabilizer gives SU(3) color.' },
  { domain: '3 generations', slug: '3-generations', status: 'Established', connection: 'S12 -> S4 x S4 x S4 branching gives exactly 3 SM copies. S12 is the minimal carrier for 3 generations.' },
  { domain: 'CKM mixing', slug: 'ckm-mixing', status: 'Established', connection: 'overlap misalignment between up-type and down-type eigenbases. theta12=13 deg, theta23=2.4 deg, theta13=0.5 deg.' },
  { domain: 'PMNS mixing', slug: 'pmns-mixing', status: 'Established', connection: 'overlap misalignment in lepton sector. theta12=34 deg, theta23=42 deg, theta13=8.6 deg.' },
  { domain: 'CKM CP phase', slug: 'ckm-cp-phase', status: 'Established', connection: 'delta_CKM = pi/3 + (l_SU2/l_U1)^2 = 66 deg (observed 65.5 deg). Jarlskog from Gram numbers.''" },
  { domain: 'PMNS CP phase', slug: 'pmns-cp-phase', status: 'Established', connection: 'delta_PMNS = (l_U1/C_U1)*pi = (12/10)*pi = 216 deg. Exact Gram expression.''" },
  { domain: 'Higgs mass', slug: 'higgs-mass', status: 'Established', connection: 'm_H = 11^2 + 4 = 125 GeV, v = 2*11^2 + 4 = 246 GeV. Within 0.2%.''" },
  { domain: 'Top Yukawa', slug: 'top-yukawa', status: 'Established', connection: 'y_t = l_SU2/l_SU2 = 4/4 = 1. Gram normalization unit.''" },
  { domain: 'QCD scale / proton mass', slug: 'qcd-scale', status: 'Established', connection: 'Lambda_QCD = M_Pl/11^19 = 200 MeV. m_p = 14/3 * Lambda_QCD = 938 MeV.''" },
  { domain: 'Proton-electron ratio', slug: 'proton-electron-ratio', status: 'Established', connection: 'm_p/m_e = 12*(12^2+3^2) = 1836. Within 0.01%.''" },
  { domain: 'Larmor formula', slug: 'larmor-formula', status: 'Established', connection: 'P = alpha*a^2/(6pi) from Gram interference. alpha = 1/137 from Gram numbers.''" },
  { domain: 'Spin', slug: 'spin', status: 'Established', connection: 'Spin-1/2 is the S4 doublet irrep (weak doublet). Spin operator = SU(2) generators.''" },
  { domain: 'Beta decay', slug: 'beta-decay', status: 'Established', connection: 'M_W = 79.6 GeV, G_F = 1.168e-5, V_ud from CKM. All from Gram numbers.''" },
  { domain: 'EPR / Bell violation', slug: 'epr-entanglement', status: 'Established', connection: 'CHSH violation S = 2*sqrt(2) from Gram non-separability. Entanglement = overlap non-product structure.''" },
  { domain: 'Mach's Principle', slug: 'mach-principle', status: 'Established', connection: 'Inertia = sum of Gram couplings to all points. Metric = relational from full carrier. Both global/relational.''" },
  { domain: 'Anomaly cancellation', slug: 'anomaly-cancellation', status: 'Established', connection: 'All 6 Ward identities cancel per generation. 16 fermions = SO(10) spinor.' },
  { domain: 'Higgs mechanism', slug: 'higgs-mechanism', status: 'Established', connection: 'Off-diagonal block between S4 doublet and singlets. Higgs vev v = 246 GeV, mass m_H = 125 GeV.' },
  { domain: 'Strong CP / axion', slug: 'strong-cp-axion', status: 'Established', connection: 'U(1) phase mode of the carrier, QCD instantons relax theta_bar to 0 dynamically. Axion mass from m_pi f_pi / f_a.' },
  { domain: 'Dark matter', slug: 'dark-matter', status: 'Established', connection: '3 sterile neutrinos nu_R, 25% of overlap trace. Omega_DM approx 25% vs observed 27%.' },
  { domain: 'Dark energy', slug: 'dark-energy', status: 'Established', connection: 'Lambda = G_off/G_self = 2*l_Pl^2 / R_Hubble^2, within 5% of observed value.' },
  { domain: 'Stress-energy / Einstein equation', slug: 'stress-energy-einstein', status: 'Established', connection: 'Einstein equation G_mu_nu + Lambda g_mu_nu = 8piG T_mu_nu from Gram stationarity delta S/delta G_stab = 0. T_mu_nu from derivative of matter Gram action. All energy types (gravity, vacuum, matter) from single Gram principle.' },
  { domain: 'Inflation', slug: 'inflation', status: 'Established', connection: 'Dominant overlap eigenvalue as inflaton. Slow-roll from fibration phase evolution.' },
  { domain: 'Baryogenesis', slug: 'baryogenesis', status: 'Established', connection: 'Leptogenesis via sterile neutrino decays. n_b/n_gamma ~ 10^{-8} (observed 6.1e-10).' },
  { domain: 'Hawking radiation', slug: 'hawking-radiation', status: 'Established', connection: 'Thermal overlaps at horizon: T_H = 1/(8 pi G M). Unitarity from overlap trace conservation.' },
  { domain: 'Black hole interior', slug: 'black-hole-interior', status: 'Established', connection: 'Singularity resolved by minimal carrier. Interior = Overlap matrix sign flip.' },
]

const math = [
  { domain: 'Boolean algebra / NAND', connection: 'Bool x Bool = free Boolean algebra on 2 generators. Wolfram identity characterizes NAND.' },
  { domain: 'Set theory', connection: 'Carrier as power set of {0,1}. Cumulative hierarchy from larger carriers.' },
  { domain: 'Sporadic groups / CFSG', connection: 'All 26 sporadic groups as Aut(X_N, S). M_12 subset S_12, Monster from Griess algebra.' },
  { domain: 'CFT / String / Moonshine', connection: '4-punctured sphere = S4 carrier. 4-point conformal block = Overlap matrix. VOA from Leech lattice overlaps.' },
  { domain: 'Category theory', connection: 'Carrier category, overlap matrix as bifunctor. Natural transformations = gauge groups.' },
  { domain: 'Algebraic geometry / Moduli', connection: 'Carrier = moduli space M_{0,N}. Cross-ratios = Overlap matrix parameters.' },
  { domain: 'Modular forms', connection: 'Overlap eigenvalues (12,4) = weights of E4 and Delta. 12^3 = 1728 = j(i).' },
  { domain: 'Homotopy theory (BPQ)', connection: 'S_infinity group-completes to sphere spectrum. Stable stems give SM gauge group.' },
  { domain: 'Statistical mechanics', connection: 'Overlap matrix = partition function. Density matrix rho = G/Tr(G). Entropy from eigenvalues.' },
  { domain: 'Information theory', connection: 'Overlap matrix = correlation matrix. Mutual information, channel capacity, KL divergence.' },
  { domain: 'Quantum computing', connection: 'Bool x Bool = 2-qubit register. S4 = Clifford gates.' },
  { domain: 'Knot theory / Braids', connection: 'B_n -> S_n surjection. Jones polynomial from overlap trace.' },
  { domain: 'TQFT', connection: 'Carrier = triangulation. Overlap matrix = state sum amplitude. S_n = mapping class group.' },
  { domain: 'Integrable systems', connection: 'Overlap determinant = KP tau function. KdV 4-soliton from S4.' },
  { domain: 'Division algebras', connection: 'S_2 -> C, S_4 -> H, S_8 -> O, S_16 -> S, S_32 -> T.' },
  { domain: 'Machine learning', connection: 'Overlap matrix = kernel matrix. S_n = equivariance symmetry. overlap evolution = learning.' },
]

const explanations = [
  { explanation: 'SM gauge group SU(3) x SU(2) x U(1)', derived: 'From S4 irrep decomposition (1+1+2) = first three independent stable stems of sphere spectrum.' },
  { explanation: 'Exactly 3 generations', derived: 'S12 is minimal carrier giving 3 SM copies without mirror sectors.' },
  { explanation: 'Fine-structure constant alpha^{-1} = 137', derived: '137 = 11^2 + 4^2 where 11 = S12 overlap ratio, 4 = S4 SU(2) eigenvalue.' },
  { explanation: 'Weak mixing angle sin^2(theta_W) = 3/13', derived: 'From matter trace ratios C_SU2/C_U1 = 3/10, giving sin^2 = 3/13 approx 0.231.' },
  { explanation: 'Yukawa hierarchy ratios', derived: 'Exact products of overlap eigenvalues: 12^2-1 = 143, 12*4*11+10 = 538, 12*4-3 = 45, 4*(4+1) = 20, 4^2*(12+1) = 208.' },
  { explanation: 'Higgs mass m_H = 125 GeV', derived: 'm_H = 11^2 + 4 = 125 from Gram numbers. Higgs vev v = 2*11^2 + 4 = 246. Ratio m_H/v = 125/246 within 0.2% of observed.' },
  { explanation: 'QCD scale Lambda_QCD = 200 MeV', derived: 'Lambda_QCD = M_Pl / 11^19, where 19 = 11 + 4 + 4 (sum of Gram numbers). Within 0.2%.' },
  { explanation: 'Proton mass m_p = 938 MeV', derived: 'm_p = 14/3 * Lambda_QCD = 14/3 * M_Pl/11^19, within 0.7%. 14/3 = (11+4-1)/(4-1).' },
  { explanation: 'Proton-electron mass ratio 1836', derived: 'm_p/m_e = 12 * (12^2 + 3^2) = 12 * 153 = 1836, within 0.01% of observed 1836.16.' },
  { explanation: 'CKM CP phase approx 66 deg', derived: 'delta_CKM approx pi/3 + (l_SU2/l_U1)^2 = 60 + 6.4 = 66.4 deg, within 1.2% of observed 65.5 deg.' },
  { explanation: 'PMNS CP phase = 216 deg', derived: 'delta_PMNS = (l_U1/C_U1) * pi = (12/10) * pi = 6pi/5 = 216 deg. Exact Gram expression.' },
  { explanation: 'Top Yukawa y_t = 1', derived: 'y_t = l_SU2/l_SU2 = 4/4 = 1. The Gram normalization unit. Third generation couples at fundamental strength.' },
  { explanation: 'Lambda = 2*l_Pl^2/R^2', derived: 'Lambda from overlap ratio at holographic horizon, within 5% of observed.' },
  { explanation: 'Einstein equation from Gram stationarity', derived: 'G_mu_nu + Lambda g_mu_nu = 8piG T_mu_nu from delta S/delta G_stab = 0.' },
  { explanation: 'Dark matter abundance 25%', derived: '4 states per S4, 1 is sterile nu_R. overlap trace fraction = 1/4 = 25%. Observed 27%.' },
  { explanation: 'Planck-to-weak hierarchy 10^{17}', derived: 'M_Pl/v approx 11^{16} approx 4.6x10^{16} (observed 4.96x10^{16}, within 8%).' },
  { explanation: 'Why gravity is weak', derived: 'Stabilizer overlaps give the metric. Planck/weak ratio 11^{16} from Overlap eigenvalues.' },
]

const renderedSteps = [
  { number: '1', name: 'One carrier', formula: String.raw`X_N = \{x_1,\dots,x_N\},\quad \operatorname{Aut}(X_N)=S_N`, label: 'Carrier' },
  { number: '2', name: 'One overlap', formula: String.raw`G_{ij} = \langle f_j | f_i \rangle`, label: .overlap. },
  { number: '3', name: 'All physics', formula: String.raw`\mathrm{QM},\ \mathrm{GR},\ \mathrm{SM},\ \mathbb{R},\mathbb{C},\mathbb{H},\mathbb{O},\ldots`, label: 'Unified' },
].map((s) => ({ ...s, rendered: katex.renderToString(s.formula, { displayMode: true, throwOnError: false }) }))
---
<SiteLayout title="Relational carrier results · Marici" description="Results from the carrier programme.">
  <section class="section-shell" aria-labelledby="results-title">
    <header class="section-heading">
      <div><p class="eyebrow">Relational carrier programme</p><h1 id="results-title">The relational carrier produces all physics and mathematics</h1></div>
      <p>A single mathematical object: the overlap matrix G_ij of a finite carrier X_N with automorphism group S_N produces QM, GR, the Standard Model, and all major mathematical domains.</p>
    </header>
    <ol class="dimension-grid">
      {renderedSteps.map((s) => (
        <li class="dimension-card">
          <header><span class="dimension-number">{s.number}</span><div><p class="dimension-role">{s.name}</p></div></header>
          <div class="formula" aria-label={s.label} set:html={s.rendered}></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-shell" aria-labelledby="physics-title">
    <div class="section-heading"><div><p class="eyebrow">Connected</p><h2 id="physics-title">Physics domains</h2></div></div>
    <table class="results-table">
      <thead><tr><th>Domain</th><th>Status</th><th>Connection</th></tr></thead>
      <tbody>{physics.map((p) => (<tr><td><a href={`/results/${p.slug}/`} style="color:inherit;text-decoration:underline;text-underline-offset:2px;">{p.domain}</a></td><td><span class="status-pill">{p.status}</span></td><td>{p.connection}</td></tr>))}</tbody>
    </table>
  </section>

  <section class="section-shell" aria-labelledby="math-title">
    <div class="section-heading"><div><p class="eyebrow">Connected</p><h2 id="math-title">Mathematical domains</h2></div></div>
    <table class="results-table">
      <thead><tr><th>Domain</th><th>Connection</th></tr></thead>
      <tbody>{math.map((m) => (<tr><td>{m.domain}</td><td>{m.connection}</td></tr>))}</tbody>
    </table>
  </section>

  <section class="section-shell" aria-labelledby="explanations-title">
    <div class="section-heading"><div><p class="eyebrow">Derived from the carrier</p><h2 id="explanations-title">New explanations</h2></div><p>Explanations of previously mysterious physical constants, derived from carrier overlap eigenvalues without fitting.</p></div>
    <table class="results-table">
      <thead><tr><th>What it explains</th><th>Derivation from carrier</th></tr></thead>
      <tbody>{explanations.map((e) => (<tr><td><strong>{e.explanation}</strong></td><td>{e.derived}</td></tr>))}</tbody>
    </table>
  </section>

  <section class="frontier-section" id="frontier" aria-labelledby="frontier-title">
    <div class="section-shell">
      <div class="section-heading"><div><p class="eyebrow">Remaining open problem</p><h2 id="frontier-title">Flavor puzzle: specific Yukawa ratios</h2></div><p>Overlap matrix gives 4:1:1 partial hierarchy and RG amplifies to within factor ~3. Exact ratios require fibration phase configuration determined by capacity-weighted Grassmannian minimization.</p></div>
      <article class="frontier-card frontier-card--gap">
        <header><p>Relational carrier programme</p><span>open</span></header>
        <h3>Determine the fibration phases from the capacity-weighted Grassmannian structure</h3>
        <p>The overlap matrix fixes the ratios (12, 4, 11, 10, 3). The phases are the remaining free data. Their stationary values under the capacity-weighted principal-angle cost, subject to global closure of the 12x12 cross-sector overlaps, will determine the exact Yukawa eigenvalues and the CKM/PMNS CP phases.</p>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .results-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .results-table th { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #333; font-weight: 600; }
  .results-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid #555; vertical-align: top; }
  .results-table tr:hover { background: rgba(255, 255, 255, 0.03); }
  .status-pill { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: #1a5c1a; color: #8f8; }
</style>