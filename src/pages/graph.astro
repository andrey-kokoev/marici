  .graph-legend { position: absolute; top: 14px; left: 14px; display: flex; flex-wrap: wrap; gap: 8px 13px; max-width: calc(100% - 28px); padding: 9px 12px; border: 1px solid var(--line-soft); border-radius: 9px; background: rgb(7 17 23 / 82%); color: var(--muted); font: .65rem Consolas, monospace; text-transform: uppercase; backdrop-filter: blur(10px); }
  .graph-legend :global(span) { display: inline-flex; align-items: center; gap: 6px; }
