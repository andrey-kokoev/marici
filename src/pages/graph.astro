  .graph-inspector :global(code) { display: block; overflow-wrap: anywhere; }
  .graph-inspector :global(h3) { margin: 30px 0 12px; color: var(--muted); font-size: .78rem; text-transform: uppercase; }
  .graph-inspector :global(.relation-group h3) { display: flex; justify-content: space-between; margin-top: 20px; }
  .graph-inspector :global(.relation-group h3 b) { color: var(--dim); }
  .graph-inspector :global(.relation-list) { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
