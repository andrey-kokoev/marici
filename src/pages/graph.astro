  .graph-canvas :global(.graph-edge) { stroke: rgb(119 151 155 / 13%); stroke-width: 1; transition: opacity .18s, stroke .18s; }
  .graph-canvas :global(.graph-edge.is-active) { stroke: var(--ochre); stroke-width: 2; opacity: .8; }
  .graph-canvas :global(.graph-edge.is-time-added) { stroke: #72d6aa; stroke-width: 1.6; opacity: .72; }
  .graph-canvas :global(.graph-edge.is-time-context:not(.is-active)) { opacity: .08; }
  .graph-canvas :global(.graph-edge.is-muted), .graph-canvas :global(.graph-node.is-muted) { opacity: .07; }
