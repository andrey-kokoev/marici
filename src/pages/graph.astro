  .graph-inspector :global(button) { border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: var(--panel-raised); cursor: pointer; }
  .graph-inspector :global(button:hover), .graph-inspector :global(button:focus-visible) { border-color: var(--ochre); color: var(--ochre); }
  .graph-inspector :global(.inspector-history) { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; margin-bottom: 18px; }
  .graph-inspector :global(.inspector-history > div) { display: flex; gap: 5px; }
  .graph-inspector :global(.inspector-history button) { width: 34px; height: 34px; font-size: 1.05rem; }
  .graph-inspector :global(.inspector-history span) { color: var(--dim); font: 650 .65rem Consolas, monospace; text-align: center; text-transform: uppercase; }
  .graph-inspector :global(.arrival-context) { padding: 9px 11px; border-left: 2px solid var(--ochre); color: var(--muted); background: rgb(255 174 98 / 7%); font-size: .72rem; }
  .graph-inspector :global(.temporal-context) { margin: 0 0 14px; padding: 8px 10px; border: 1px solid rgb(114 214 170 / 35%); border-radius: 8px; color: #72d6aa; background: rgb(114 214 170 / 7%); font: .67rem Consolas, monospace; }
  .graph-inspector :global(.temporal-context.is-future) { border-color: rgb(224 139 168 / 40%); color: #e08ba8; background: rgb(224 139 168 / 7%); }
  .graph-inspector :global(.entity-summary) { padding-bottom: 18px; border-bottom: 1px solid var(--line-soft); }
  .graph-inspector :global(.entity-badges) { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .graph-inspector :global(.entity-badges span) { padding: 3px 7px; border: 1px solid var(--line); border-radius: 99px; color: var(--ochre); font: 650 .62rem Consolas, monospace; text-transform: uppercase; }
  .graph-inspector :global(.entity-description) { color: var(--muted); font-size: .86rem; }
  .graph-inspector :global(.entity-summary > h2) { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  .graph-inspector :global(.entity-provenance) { margin: 12px 0 0; color: var(--dim); font: .67rem/1.5 Consolas, monospace; }
  .graph-inspector :global(.entity-provenance a) { color: var(--ochre); }
  .graph-inspector :global(.technical-identity) { margin-top: 12px; color: var(--dim); font: .66rem Consolas, monospace; }
  .graph-inspector :global(.technical-identity summary) { cursor: pointer; }
  .graph-inspector :global(.technical-identity code) { margin-top: 8px; }
  .graph-inspector :global(.inspector-actions) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; margin-top: 16px; }
  .graph-inspector :global(.inspector-actions button) { min-height: 38px; padding: 7px; font-size: .7rem; }
  .graph-inspector :global(.action-primary) { border-color: var(--ochre); color: #071117; background: var(--ochre); font-weight: 750; }
  .graph-inspector :global(.action-primary:hover) { color: #071117; filter: brightness(1.08); }
