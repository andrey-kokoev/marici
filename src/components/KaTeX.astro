---
import katex from 'katex'
import 'katex/dist/katex.min.css'

interface Props {
  tex: string
  displayMode?: boolean
  label?: string
}

const { tex, displayMode = false, label } = Astro.props
const html = katex.renderToString(tex, {
  displayMode,
  throwOnError: false,
  output: 'htmlAndMathml',
})
---
<span class={displayMode ? 'math-formula math-display' : 'math-formula'} aria-label={label ?? tex} set:html={html}></span>

<style>
  .math-display { display: block; overflow-x: auto; padding: .25em 0; }
</style>
