{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.vue"],
  "exclude": ["**/node_modules", ".verification", "dist"],
  "vueCompilerOptions": { "strictTemplates": true }
}
