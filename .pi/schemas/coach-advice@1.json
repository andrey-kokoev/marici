{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coach-advice@1",
  "title": "Coach boundary advice",
  "description": "A bounded recommendation returned by a coach.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "severity",
    "message",
    "evidence",
    "missing_fields",
    "source_boundary"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["ignore", "notify", "advise"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "urgent"]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 8
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 16
    },
    "source_boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema": {
      "type": "string",
      "enum": ["coach-advice@1"]
    }
  }
}
