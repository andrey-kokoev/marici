      "local_ref": "claim",
      "kind": "claim",
      "title": "Smith divisibility gives the minimal localization for a Betti adjoint",
      "statement": "For U P_H V=diag(d_i) and B'=UQ^TP_G, reduced denominators e_ij=d_i/gcd(d_i,B'_ij) have lcm L. Integral adjunction exists iff L=1; localization works exactly after inverting the prime support of L.",
      "entity_id": "claim:f8e62bcfb8ea18dfa325"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "Pairing determinant overestimates adjoint localization",
      "procedure": "Compare P_H=[6],B=[4] with P_H=[6],B=[6].",
      "outcome": "The first has minimal denominator L=3; the second has L=1 despite the same pairing determinant.",
      "falsifier": "This falsifies using determinant primes alone as the integral-adjoint obstruction.",
      "entity_id": "test:df5c380e50424c633cc3"
    },
