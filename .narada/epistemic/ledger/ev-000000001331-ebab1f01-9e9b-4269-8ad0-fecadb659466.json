      "op": "entity.declare",
      "local_ref": "claim",
      "kind": "claim",
      "title": "Homology descent is strictly weaker than a physical chain map",
      "statement": "A graded map S induces H_n(G)->H_n(H) exactly when Omega_n vanishes on Z_n(G) and Omega_(n+1)(C_(n+1)(G)) lies in B_n(H). These conditions can hold with Omega nonzero.",
      "entity_id": "claim:b675d08704b0332aaddf"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "Contractible-summand separation of homology descent from chain compatibility",
      "procedure": "Take D_G=D_H=diag(1,0), S_1=diag(0,1), S_0=diag(1,1).",
      "outcome": "Omega_1=diag(-1,0) is nonzero, but S induces the identity on the surviving homology summand.",
      "falsifier": "This falsifies the inference that failure of strict chain compatibility necessarily destroys every class-level readout.",
      "entity_id": "test:b93121890b88a4adb495"
    },
