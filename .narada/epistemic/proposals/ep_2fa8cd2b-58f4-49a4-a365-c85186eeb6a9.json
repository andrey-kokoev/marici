      "kind": "claim",
      "title": "The residual mod-two norm homology has a closed Hilbert series",
      "statement": "For k collapsed five-site directions, H_k(t)=(1+t)^(5-k)((1+t)^k-1-t^k). Its basis is indexed by proper nonempty collapsed subsets times arbitrary untouched subsets.",
      "entity_id": "claim:c588d3f5bf59b782fabe"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "Hilbert-series controls for one, two, and five collapsed bits",
      "procedure": "Evaluate the closed formula at k=1,2,5.",
      "outcome": "It gives 0; 2t(1+t)^3 with dimensions 2,6,6,2; and 5t+10t^2+10t^3+5t^4.",
      "falsifier": "Any proposed graded census inconsistent with these coefficients falsifies the deck norm-homology identification.",
