    {
      "op": "entity.declare",
      "local_ref": "claim",
      "kind": "claim",
      "title": "The source-side Mackey norm is a degree-idempotent",
      "statement": "From ST=dI, N=TS satisfies N^2=dN. After inverting d it is a projector onto im T along ker S; at primes dividing d it becomes square-zero and may remain nonzero.",
      "entity_id": "claim:a56a7a29f3184513ad3b"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "One-bit mod-two norm is nonzero square-zero",
      "procedure": "Take S=[1 1], T=[1;1], d=2 and reduce N=TS modulo two.",
      "outcome": "N=[[1,1],[1,1]] is nonzero, N^2=0, and image equals kernel.",
      "falsifier": "This falsifies treating the integral norm identity as an unlocalized chain splitting.",
      "entity_id": "test:78a9fe1b4ff9cff5b05f"
    },
