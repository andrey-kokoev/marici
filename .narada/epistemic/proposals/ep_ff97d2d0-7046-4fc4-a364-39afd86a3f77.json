      "kind": "claim",
      "title": "Betti boundary defects obey a Leibniz law",
      "statement": "For composable pairing-forced maps S_q and S_r, Omega_(rq)=Omega_r S_q+S_r Omega_q. Chain-map stages compose, but a zero composite defect need not imply zero stage defects because cancellation can occur.",
      "entity_id": "claim:e7c75f11d7c6460fee53"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "Rank-one cancellation falsifies stage inference from a composite",
      "procedure": "Use two-term rank-one complexes with D_G=0, D_H=1, D_J=0 and identity S_q,S_r in both degrees.",
      "outcome": "Omega_q=1, Omega_r=-1, and Omega_(rq)=0.",
      "falsifier": "This falsifies the inference that a passing terminal quotient certifies every constituent specialization.",
      "entity_id": "test:143d49f73d0c79ba18bb"
