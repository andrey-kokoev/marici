      "kind": "claim",
      "title": "Smith factors exactly decide an integral Mackey trace",
      "statement": "For integral S:Z^n->Z^m, an integral T with ST=dI exists iff S has full row rank and every Smith invariant s_i divides d. The minimal possible norm scalar is lcm(s_i).",
      "entity_id": "claim:87abcbe7e96f8f3d5605"
    },
    {
      "op": "entity.declare",
      "local_ref": "test",
      "kind": "test",
      "title": "Rank-one Smith factor rejects an incompatible norm degree",
      "procedure": "Take S=[2] and prescribed d=3, then compare d=4.",
      "outcome": "No integral trace exists for d=3; T=[2] works for d=4.",
      "falsifier": "Any Smith invariant not dividing the geometric degree falsifies the integral Mackey trace.",
      "entity_id": "test:01e1b1d47ce07f2c3e1e"
